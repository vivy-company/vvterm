---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import DownloadButton from "../../components/DownloadButton.astro";
import CTABand from "../../components/CTABand.astro";
import { Icon } from "astro-icon/components";
import { GUIDES } from "../../lib/nav";
import { localizePath, pickPage } from "../../i18n/utils";

const lang = (Astro.currentLocale ?? "en") as "en" | "zh";

const C = pickPage("guides", lang);

const categoryOrder = ["Getting started", "Connections", "Files"];

const groups = categoryOrder
  .map((name) => ({ name, items: GUIDES.filter((g) => g.category === name) }))
  .filter((group) => group.items.length > 0);

const cardTitle = (slug: string, fallback: string) => C.guides[slug]?.title ?? fallback;
const cardSummary = (slug: string, fallback: string) => C.guides[slug]?.summary ?? fallback;
---

<MarketingLayout
  title={C.title}
  description={C.description}
  canonicalPath="/guides"
  activeTop="resources"
>
  <Breadcrumbs items={[{ name: C.bcHome, href: "/" }, { name: C.bcGuides, href: "/guides" }]} />

  <!-- HERO -->
  <section class="px-6 pb-8 pt-10 text-center sm:pt-14">
    <div class="mx-auto max-w-4xl">
      <Icon class="mx-auto size-12 text-ink" name="lucide:book-open" />
      <p class="mt-5 eyebrow-accent">{C.heroEyebrow}</p>
      <h1 class="mt-3 headline-hero" set:html={C.heroTitle} />
      <p class="mx-auto mt-6 max-w-2xl subhead">{C.heroSubhead}</p>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-x-7 gap-y-4">
        <DownloadButton label={C.download} track="guides_hub_appstore" />
        <a href={localizePath("/docs", lang)} class="link-arrow">{C.browseDocs} <span aria-hidden="true">›</span></a>
      </div>
      <p class="mt-5 text-[13px] text-faint">{C.heroNote}</p>
    </div>
  </section>

  <!-- GUIDE GROUPS -->
  <section class="px-6 pb-24 pt-12 sm:pb-32 sm:pt-16">
    <div class="container-wide grid gap-20 sm:gap-24">
      {groups.map((group) => (
        <div>
          <h2 class="text-3xl font-semibold tracking-[-0.02em] text-ink sm:text-4xl">{C.categories[group.name] ?? group.name}</h2>
          <div class="mt-7 grid gap-4 md:grid-cols-2">
            {group.items.map((guide) => (
              <a
                href={localizePath(`/guides/${guide.slug}`, lang)}
                class="group card flex flex-col p-8 transition hover:border-white/25"
              >
                <h3 class="text-2xl font-semibold tracking-[-0.02em] text-ink">{cardTitle(guide.slug, guide.title)}</h3>
                <p class="mt-3 flex-1 text-base leading-relaxed text-muted">{cardSummary(guide.slug, guide.summary)}</p>
                <div class="mt-6 flex items-center justify-between">
                  <span class="inline-flex link-arrow">{C.readGuide} <span aria-hidden="true">›</span></span>
                  <span class="text-[13px] text-faint">{C.minRead.replace("{m}", String(guide.minutes))}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <CTABand
    title={C.ctaTitle}
    subtitle={C.ctaSubtitle}
    track="guides_hub_cta_appstore"
  />
</MarketingLayout>
