---
import DocsLayout from "../../layouts/DocsLayout.astro";
import { SITE } from "../../lib/site";
import { localizePath, pickPage } from "../../i18n/utils";

const lang = (Astro.currentLocale ?? "en") as "en" | "zh";

const slug = "cloudflare-tunnel-ssh-setup";

const C = pickPage("guides/cloudflare-tunnel-ssh-setup", lang);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: C.heading,
  description: C.schemaDescription,
  url: `${SITE.siteUrl}${localizePath(`/guides/${slug}`, lang)}`,
};
---

<DocsLayout
  kind="guides"
  activeSlug={slug}
  heading={C.heading}
  intro={C.intro}
  meta={C.meta}
  title={C.title}
  description={C.description}
  canonicalPath={`/guides/${slug}`}
  structuredData={[articleSchema]}
>
  <Fragment set:html={C.bodyHtml} />
</DocsLayout>
