---
import DocsLayout from "../../layouts/DocsLayout.astro";
import { SITE } from "../../lib/site";
import { localizePath , pick } from "../../i18n/utils";

const lang = (Astro.currentLocale ?? "en") as "en" | "zh";

const slug = "sftp-file-transfer-on-ios";

const C = pick({
  en: {
    heading: "Transfer files over SFTP on iOS",
    intro:
      "Browse, upload, download, and edit remote files from your iPhone and iPad using VVTerm's built-in SFTP file browser — no second app required.",
    meta: "Guide",
    title: "Transfer files over SFTP on iOS — VVTerm",
    description:
      "Use VVTerm's built-in SFTP browser on iPhone and iPad to browse folders, upload and download, rename, move, delete, preview media, and edit text and POSIX permissions.",
    schemaDescription:
      "Step-by-step guide to SFTP file transfer on iOS with VVTerm: open the file browser, browse folders, upload and download, manage files, preview media, and edit text and permissions.",
    bodyHtml: `
  <p>
    Every server you connect to in VVTerm also has a built-in <strong>SFTP file browser</strong>, so you can
    manage remote files without leaving the app or installing a separate client. It works over the same SSH
    connection you already use.
  </p>

  <h2>Open the file browser</h2>
  <ol>
    <li>Connect to a server as usual.</li>
    <li>Open the <strong>Files</strong> view for that connection to switch from the terminal to the SFTP browser.</li>
    <li>VVTerm lists the contents of a starting directory — typically your home folder — over SFTP.</li>
  </ol>

  <h2>Browse remote folders</h2>
  <p>
    Tap a folder to open it and use the path or back control to move up the tree. Files show their names and
    details so you can find what you need. Browsing is read-only until you choose to transfer or change
    something, so there's no risk in simply looking around.
  </p>

  <h2>Upload and download</h2>
  <ul>
    <li><strong>Download</strong> a remote file to your device when you want a local copy, for example to save it into the Files app or share it elsewhere.</li>
    <li><strong>Upload</strong> a file from your iPhone or iPad into the current remote folder to push it to the server.</li>
  </ul>
  <p>Transfers run over the encrypted SSH connection, so files never leave a secured channel.</p>

  <h2>Manage files and folders</h2>
  <p>The browser handles the everyday file operations you'd expect on the server:</p>
  <ul>
    <li><strong>Create folders</strong> to organize remote directories.</li>
    <li><strong>Rename</strong> files and folders in place.</li>
    <li><strong>Move</strong> items to a different directory.</li>
    <li><strong>Delete</strong> files and folders you no longer need.</li>
  </ul>

  <h2>Preview without downloading</h2>
  <p>
    You can <strong>preview</strong> many files directly in VVTerm before deciding what to do with them —
    text files, images, and video — so you can check a config file or a screenshot without first pulling it
    onto your device.
  </p>

  <h2>Edit text and permissions</h2>
  <ol>
    <li>Open a supported <strong>text file</strong> to edit it in place, then save the changes straight back to the server over SFTP.</li>
    <li>Adjust a file or folder's <strong>POSIX permissions</strong> — the read, write, and execute bits for owner, group, and others — when you need to fix access without dropping into the shell.</li>
  </ol>

  <h2>Tips</h2>
  <ul>
    <li>For quick config tweaks, editing a file in the SFTP browser is often faster than opening an editor in the terminal.</li>
    <li>Use preview to confirm you have the right file before downloading or deleting it.</li>
    <li>The same SFTP browser is available on iPhone, iPad, and Mac, so the workflow carries across all your devices.</li>
  </ul>
`,
  },
  zh: {
    heading: "在 iOS 上通过 SFTP 传输文件",
    intro:
      "使用 VVTerm 内置的 SFTP 文件浏览器，从你的 iPhone 和 iPad 浏览、上传、下载和编辑远程文件 —— 无需第二个应用。",
    meta: "指南",
    title: "在 iOS 上通过 SFTP 传输文件 — VVTerm",
    description:
      "在 iPhone 和 iPad 上使用 VVTerm 内置的 SFTP 浏览器来浏览文件夹、上传和下载、重命名、移动、删除、预览媒体，并编辑文本和 POSIX 权限。",
    schemaDescription:
      "在 iOS 上用 VVTerm 进行 SFTP 文件传输的分步指南：打开文件浏览器、浏览文件夹、上传和下载、管理文件、预览媒体，并编辑文本和权限。",
    bodyHtml: `
  <p>
    在 VVTerm 中你连接的每一台服务器都内置了一个 <strong>SFTP 文件浏览器</strong>，因此你无需离开应用或安装单独的客户端即可管理远程文件。它通过你已经在用的同一个 SSH 连接工作。
  </p>

  <h2>打开文件浏览器</h2>
  <ol>
    <li>像往常一样连接到服务器。</li>
    <li>打开该连接的<strong>文件</strong>视图，从终端切换到 SFTP 浏览器。</li>
    <li>VVTerm 会通过 SFTP 列出起始目录（通常是你的主目录）的内容。</li>
  </ol>

  <h2>浏览远程文件夹</h2>
  <p>
    点按文件夹将其打开，并使用路径或返回控件向上回到目录树。文件会显示名称和详情，方便你找到所需内容。在你选择传输或更改之前，浏览始终是只读的，因此随意查看没有任何风险。
  </p>

  <h2>上传与下载</h2>
  <ul>
    <li>当你想要本地副本时，把远程文件<strong>下载</strong>到设备，例如保存到 Files 应用或分享到别处。</li>
    <li>把 iPhone 或 iPad 上的文件<strong>上传</strong>到当前远程文件夹，将其推送到服务器。</li>
  </ul>
  <p>传输通过加密的 SSH 连接进行，因此文件始终不会离开受保护的通道。</p>

  <h2>管理文件和文件夹</h2>
  <p>浏览器可处理你期望在服务器上进行的日常文件操作：</p>
  <ul>
    <li><strong>创建文件夹</strong>来组织远程目录。</li>
    <li>就地<strong>重命名</strong>文件和文件夹。</li>
    <li>把项目<strong>移动</strong>到不同的目录。</li>
    <li><strong>删除</strong>你不再需要的文件和文件夹。</li>
  </ul>

  <h2>无需下载即可预览</h2>
  <p>
    在决定如何处理之前，你可以直接在 VVTerm 中<strong>预览</strong>许多文件 —— 文本文件、图片和视频 —— 这样你无需先把文件拉到设备上，就能查看一个配置文件或一张截图。
  </p>

  <h2>编辑文本和权限</h2>
  <ol>
    <li>打开受支持的<strong>文本文件</strong>就地编辑，然后通过 SFTP 直接把更改保存回服务器。</li>
    <li>当你需要在不进入 shell 的情况下修复访问权限时，调整文件或文件夹的 <strong>POSIX 权限</strong> —— 即所有者、组和其他人的读、写、执行位。</li>
  </ol>

  <h2>提示</h2>
  <ul>
    <li>对于快速调整配置，在 SFTP 浏览器中编辑文件往往比在终端里打开编辑器更快。</li>
    <li>在下载或删除文件前，用预览确认你选对了文件。</li>
    <li>同一个 SFTP 浏览器在 iPhone、iPad 和 Mac 上都可用，因此工作流可在你的所有设备间通用。</li>
  </ul>
`,
  },
}, lang);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: C.heading,
  description: C.schemaDescription,
  url: `${SITE.siteUrl}${localizePath(`/guides/${slug}`, lang)}`,
};
---

<DocsLayout
  kind="guides"
  activeSlug={slug}
  heading={C.heading}
  intro={C.intro}
  meta={C.meta}
  title={C.title}
  description={C.description}
  canonicalPath={`/guides/${slug}`}
  structuredData={[articleSchema]}
>
  <Fragment set:html={C.bodyHtml} />
</DocsLayout>
