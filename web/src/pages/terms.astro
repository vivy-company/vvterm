---
import LegalPage from "../components/LegalPage.astro";
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { SITE } from "../lib/site";
import { localizePath, pickPage } from "../i18n/utils";

const lang = (Astro.currentLocale ?? "en") as "en" | "zh";

const content = pickPage("terms", lang);
---

<MarketingLayout
  title={content.title}
  description={content.description}
  canonicalPath="/terms"
  ogType="article"
>
  <LegalPage title={content.heading} lastUpdated={content.lastUpdated}>
    <section>
      <h2>{content.s1h}</h2>
      <p>{content.s1p1}</p>
      <p>{content.s1p2}</p>
    </section>

    <section>
      <h2>{content.s2h}</h2>
      <p>{content.s2p1}</p>
      <p>
        {content.s2p2pre}
        <a href={SITE.githubUrl} target="_blank" rel="noopener noreferrer">{SITE.githubUrl}</a>
        {content.s2p2post}
      </p>
      <h3>{content.s2freeH}</h3>
      <p>{content.s2freeP}</p>
    </section>

    <section>
      <h2>{content.s3h}</h2>
      <p>{content.s3p1}</p>
      <p>{content.s3p2}</p>
    </section>

    <section>
      <h2>{content.s4h}</h2>
      <p>{content.s4p}</p>
    </section>

    <section>
      <h2>{content.s5h}</h2>
      <p>{content.s5p1}</p>
      <p>{content.s5p2}</p>
    </section>

    <section>
      <h2>{content.s6h}</h2>
      <p>{content.s6p}</p>
    </section>

    <section>
      <h2>{content.s7h}</h2>
      <p>{content.s7p}</p>
    </section>

    <section>
      <h2>{content.s8h}</h2>
      <p>{content.s8p}</p>
    </section>

    <section>
      <h2>{content.s9h}</h2>
      <p>{content.s9p1}</p>
      <p>{content.s9p2}</p>
    </section>

    <section>
      <h2>{content.s10h}</h2>
      <p>{content.s10intro}</p>
      <ul>
        {content.s10list.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section>
      <h2>{content.s11h}</h2>
      <p>{content.s11intro}</p>
      <ul>
        {content.s11list.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section>
      <h2>{content.s12h}</h2>
      <p>
        {content.s12pre}<a href={localizePath("/privacy", lang)}>{content.s12link}</a>{content.s12post}
      </p>
    </section>

    <section>
      <h2>{content.s13h}</h2>
      <p>{content.s13p}</p>
    </section>

    <section>
      <h2>{content.s14h}</h2>
      <p>{content.s14p}</p>
    </section>

    <section>
      <h2>{content.s15h}</h2>
      <p>{content.s15p1}</p>
      <p>{content.s15p2}</p>
    </section>

    <section>
      <h2>{content.s16h}</h2>
      <p>{content.s16p}</p>
    </section>

    <section>
      <h2>{content.s17h}</h2>
      <p>{content.s17p}</p>
    </section>

    <section>
      <h2>{content.s18h}</h2>
      <p>{content.s18p}</p>
    </section>

    <section>
      <h2>{content.s19h}</h2>
      <p>{content.s19intro}</p>
      <p>
        Vivy Technologies Co., Limited<br />
        Room 706, Ho King Commercial Centre<br />
        2-16 Fa Yuen Street, Mongkok, Kowloon<br />
        Hong Kong
      </p>
      <p>
        {content.phoneLabel}<a href="tel:+8613023122583">+86 13023122583</a><br />
        {content.emailLabel}<a href="mailto:apple@vivy.company">apple@vivy.company</a>
      </p>
    </section>
  </LegalPage>
</MarketingLayout>
