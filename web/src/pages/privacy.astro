---
import LegalPage from "../components/LegalPage.astro";
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { pick } from "../i18n/utils";

const lang = (Astro.currentLocale ?? "en") as "en" | "zh";

const content = pick({
  en: {
    title: "Privacy Policy - VVTerm",
    description:
      "Privacy Policy for VVTerm, an SSH terminal app for iOS and macOS by Vivy Technologies Co., Limited.",
    heading: "Privacy Policy",
    lastUpdated: "June 10, 2026",
    s1h: "1. Introduction",
    s1p: 'Vivy Technologies Co., Limited ("we", "our", or "us") operates VVTerm, an SSH terminal application for iOS and macOS. This Privacy Policy explains how we collect, use, and protect your information.',
    s2h: "2. Information We Collect",
    s2serverH: "Server Configurations",
    s2serverP:
      "VVTerm stores your server configurations (host, port, username) locally and syncs them via iCloud to your other devices. This data is encrypted in transit and at rest by Apple's iCloud infrastructure.",
    s2credH: "Credentials",
    s2credP:
      "SSH passwords and private keys are stored in Apple Keychain. If iCloud sync is enabled, credentials sync via iCloud Keychain across your devices. We never receive these credentials, and they are protected by your device's security.",
    s2analyticsH: "Analytics Data",
    s2analyticsP1:
      "We use Umami Analytics, a privacy-focused analytics service, to collect anonymous usage statistics on our website and in the app. The data is anonymous, processed on our own self-hosted analytics server, and never shared with third-party analytics companies or ad networks.",
    s2analyticsP2:
      'We never collect the contents of your terminal sessions, the commands you type, your server addresses, usernames, file contents, or anything that identifies you. You can turn off app analytics at any time in Settings under "Help Improve VVTerm".',
    s2purchaseH: "Purchase Information",
    s2purchaseP:
      "If you purchase VVTerm Pro, your purchase is processed through the App Store. We receive confirmation of your purchase but do not have access to your payment details.",
    s3h: "3. How We Use Your Information",
    s3list: [
      "To provide and maintain the app functionality",
      "To sync server configurations across your devices via iCloud",
      "To verify Pro subscription status",
      "To improve our website and application",
    ],
    s4h: "4. Data Storage and Security",
    s4p: "Server configurations are synced via Apple iCloud, subject to Apple's security measures. Credentials are stored in Apple Keychain and may sync via iCloud Keychain when enabled. The only data our own servers receive is the anonymous usage statistics described above. We do not sell or share your personal information with third parties.",
    s5h: "5. Your Rights",
    s5intro: "You have the right to:",
    s5list: [
      "Delete all app data by removing VVTerm from your devices",
      "Disable iCloud sync in Settings to keep data local only",
      "Remove stored credentials from Keychain at any time",
      'Turn off anonymous usage statistics in Settings ("Help Improve VVTerm")',
      "Request information about data we may have collected",
    ],
    s6h: "6. Contact Us",
    s6pre: "If you have questions about this Privacy Policy, contact ",
    s6post: ".",
  },
  zh: {
    title: "隐私政策 - VVTerm",
    description:
      "VVTerm 的隐私政策。VVTerm 是 Vivy Technologies Co., Limited 出品的 iOS 和 macOS SSH 终端应用。",
    heading: "隐私政策",
    lastUpdated: "2026年6月10日",
    s1h: "1. 引言",
    s1p: 'Vivy Technologies Co., Limited（"我们"）运营 VVTerm，一款适用于 iOS 和 macOS 的 SSH 终端应用。本隐私政策说明我们如何收集、使用和保护你的信息。',
    s2h: "2. 我们收集的信息",
    s2serverH: "服务器配置",
    s2serverP:
      "VVTerm 会将你的服务器配置（主机、端口、用户名）保存在本地，并通过 iCloud 同步到你的其他设备。这些数据在传输和存储过程中均由 Apple 的 iCloud 基础设施加密。",
    s2credH: "凭据",
    s2credP:
      "SSH 密码和私钥保存在 Apple Keychain 中。如果启用了 iCloud 同步，凭据会通过 iCloud Keychain 在你的设备之间同步。我们永远不会获取这些凭据，它们受你设备的安全机制保护。",
    s2analyticsH: "分析数据",
    s2analyticsP1:
      "我们使用注重隐私的分析服务 Umami Analytics，在我们的网站和应用中收集匿名的使用统计。这些数据是匿名的，由我们自托管的分析服务器处理，绝不会与第三方分析公司或广告网络共享。",
    s2analyticsP2:
      '我们绝不会收集你的终端会话内容、你输入的命令、你的服务器地址、用户名、文件内容，或任何可识别你身份的信息。你可以随时在"设置"的"帮助改进 VVTerm"中关闭应用分析。',
    s2purchaseH: "购买信息",
    s2purchaseP:
      "如果你购买 VVTerm Pro，购买将通过 App Store 处理。我们会收到你的购买确认，但无法获取你的支付详情。",
    s3h: "3. 我们如何使用你的信息",
    s3list: [
      "提供和维护应用功能",
      "通过 iCloud 在你的设备之间同步服务器配置",
      "验证 Pro 订阅状态",
      "改进我们的网站和应用",
    ],
    s4h: "4. 数据存储与安全",
    s4p: "服务器配置通过 Apple iCloud 同步，受 Apple 的安全措施保护。凭据保存在 Apple Keychain 中，启用后可通过 iCloud Keychain 同步。我们自己的服务器仅收到上述匿名使用统计数据。我们不会向第三方出售或共享你的个人信息。",
    s5h: "5. 你的权利",
    s5intro: "你有权：",
    s5list: [
      "通过从设备中删除 VVTerm 来删除所有应用数据",
      "在设置中关闭 iCloud 同步，使数据仅保留在本地",
      "随时从 Keychain 中移除已保存的凭据",
      '在设置（"帮助改进 VVTerm"）中关闭匿名使用统计',
      "请求了解我们可能已收集的数据信息",
    ],
    s6h: "6. 联系我们",
    s6pre: "如果你对本隐私政策有疑问，请联系 ",
    s6post: "。",
  },
}, lang);
---

<MarketingLayout
  title={content.title}
  description={content.description}
  canonicalPath="/privacy"
  ogType="article"
>
  <LegalPage title={content.heading} lastUpdated={content.lastUpdated}>
    <section>
      <h2>{content.s1h}</h2>
      <p>{content.s1p}</p>
    </section>

    <section>
      <h2>{content.s2h}</h2>
      <h3>{content.s2serverH}</h3>
      <p>{content.s2serverP}</p>
      <h3>{content.s2credH}</h3>
      <p>{content.s2credP}</p>
      <h3>{content.s2analyticsH}</h3>
      <p>{content.s2analyticsP1}</p>
      <p>{content.s2analyticsP2}</p>
      <h3>{content.s2purchaseH}</h3>
      <p>{content.s2purchaseP}</p>
    </section>

    <section>
      <h2>{content.s3h}</h2>
      <ul>
        {content.s3list.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section>
      <h2>{content.s4h}</h2>
      <p>{content.s4p}</p>
    </section>

    <section>
      <h2>{content.s5h}</h2>
      <p>{content.s5intro}</p>
      <ul>
        {content.s5list.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section>
      <h2>{content.s6h}</h2>
      <p>
        {content.s6pre}<a href="mailto:vvterm@vivy.company">vvterm@vivy.company</a>{content.s6post}
      </p>
    </section>
  </LegalPage>
</MarketingLayout>
