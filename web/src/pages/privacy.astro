---
import LegalPage from "../components/LegalPage.astro";
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { pickPage } from "../i18n/utils";

const lang = (Astro.currentLocale ?? "en") as "en" | "zh";

const content = pickPage("privacy", lang);
---

<MarketingLayout
  title={content.title}
  description={content.description}
  canonicalPath="/privacy"
  ogType="article"
>
  <LegalPage title={content.heading} lastUpdated={content.lastUpdated}>
    <section>
      <h2>{content.s1h}</h2>
      <p>{content.s1p}</p>
    </section>

    <section>
      <h2>{content.s2h}</h2>
      <h3>{content.s2serverH}</h3>
      <p>{content.s2serverP}</p>
      <h3>{content.s2credH}</h3>
      <p>{content.s2credP}</p>
      <h3>{content.s2analyticsH}</h3>
      <p>{content.s2analyticsP1}</p>
      <p>{content.s2analyticsP2}</p>
      <h3>{content.s2purchaseH}</h3>
      <p>{content.s2purchaseP}</p>
    </section>

    <section>
      <h2>{content.s3h}</h2>
      <ul>
        {content.s3list.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section>
      <h2>{content.s4h}</h2>
      <p>{content.s4p}</p>
    </section>

    <section>
      <h2>{content.s5h}</h2>
      <p>{content.s5intro}</p>
      <ul>
        {content.s5list.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section>
      <h2>{content.s6h}</h2>
      <p>
        {content.s6pre}<a href="mailto:vvterm@vivy.company">vvterm@vivy.company</a>{content.s6post}
      </p>
    </section>
  </LegalPage>
</MarketingLayout>
