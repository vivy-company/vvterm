---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import DownloadButton from "../../components/DownloadButton.astro";
import CTABand from "../../components/CTABand.astro";
import FaqAccordion from "../../components/FaqAccordion.astro";
import MediaBlock from "../../components/MediaBlock.astro";
import Expandable from "../../components/Expandable.astro";
import { Icon } from "astro-icon/components";
import { localizePath , pick } from "../../i18n/utils";

const lang = (Astro.currentLocale ?? "en") as "en" | "zh";
const competitor = "Blink Shell";

type Cell = string | "check" | "cross" | "dash";

const C = pick({
  en: {
    title: "VVTerm vs Blink Shell — Apple SSH Terminals Compared",
    description:
      "VVTerm vs Blink Shell: two Mosh-capable Apple terminals compared on platforms, transports, the built-in SFTP file browser, iCloud sync, and pricing.",
    bcHome: "Home",
    bcCompare: "Comparisons",
    heroTitle: "Two Apple terminals,<br />both built for Mosh.",
    heroSubhead:
      "VVTerm and Blink Shell are both native, Mosh-capable Apple terminals. VVTerm runs on iPhone, iPad, and Mac, while Blink Shell focuses on iPhone and iPad. The differences also show up in the SFTP file browser, the transports on offer, iCloud sync, and how each one is priced. Here is a fair look at both.",
    download: "Download VVTerm",
    seePricing: "See pricing",
    heroNote: "iPhone, iPad, and Mac · Apple-only by design",
    heroAlt: "VVTerm terminal and SFTP browser on Apple devices",
    tableEyebrow: "Feature by feature",
    tableTitle: "VVTerm and Blink Shell, side by side.",
    tableBody:
      "Both are <strong>native Apple terminals</strong> with <strong>Mosh</strong> at the core. VVTerm adds a built-in SFTP browser, extra transports, and a lifetime option.",
    colFeature: "Feature",
    footnote:
      'Blink Shell details are based on publicly available information and may change; check the vendor\'s site for current details. Cells marked "—" or "Varies" indicate features that differ by plan or that we do not assert as a definitive fact.',
    standoutEyebrow: "Where VVTerm stands out",
    standoutTitle: "More than a terminal.",
    whyLabel: "Why VVTerm?",
    whyEyebrow: "Why VVTerm",
    whyTitle: "Mosh, and a lot more.",
    whyBody:
      "Both apps do Mosh well. VVTerm pairs it with a <strong>GPU terminal powered by libghostty</strong>, a built-in <strong>SFTP file browser</strong> with text, image, and video preview, extra transports like <strong>Tailscale SSH and Cloudflare Tunnel SSH</strong>, <strong>iCloud metadata sync</strong>, and a one-time <strong>$49.99 lifetime</strong> option.",
    whyAlt: "VVTerm SFTP file browser beside the shell",
    seeEverything: "See everything VVTerm does",
    fitEyebrow: "Where Blink Shell might fit",
    fitTitle: "A mature, terminal-first tool.",
    fitBody:
      "Blink Shell has been a respected name in the iOS terminal world for years, with a <strong>strong Mosh focus</strong> and a deeply <strong>keyboard-driven, terminal-centric</strong> workflow that many power users love. If your priority is a battle-tested shell with a configuration-heavy, command-line-first approach — and a community that has refined it over a long time — it is an excellent option. VVTerm aims at a different balance: a native GPU terminal paired with a built-in SFTP browser, iCloud sync, and extra transports, with a lifetime price.",
    rows: [
      { label: "Platforms", vvterm: "iPhone, iPad, Mac", competitor: "iPhone, iPad" },
      { label: "Native Apple app", vvterm: "check", competitor: "check" },
      { label: "Terminal engine", vvterm: "libghostty (GPU)", competitor: "—" },
      { label: "Standard SSH", vvterm: "check", competitor: "check" },
      { label: "Mosh", vvterm: "check", competitor: "check" },
      { label: "Tailscale SSH", vvterm: "check", competitor: "—" },
      { label: "Cloudflare Tunnel SSH", vvterm: "check", competitor: "—" },
      { label: "Built-in SFTP file browser", vvterm: "check", competitor: "Varies" },
      { label: "File preview (text/image/video)", vvterm: "check", competitor: "—" },
      { label: "Managed tmux session persistence", vvterm: "check", competitor: "—" },
      { label: "Connect to Windows/PowerShell servers", vvterm: "check", competitor: "check" },
      { label: "Live server metrics (CPU/RAM/disk)", vvterm: "check", competitor: "—" },
      { label: "On-device voice-to-command", vvterm: "check", competitor: "—" },
      { label: "Built-in terminal themes", vvterm: "440 themes", competitor: "Varies" },
      { label: "iCloud sync", vvterm: "check", competitor: "Varies" },
      { label: "Credentials in Apple Keychain", vvterm: "check", competitor: "—" },
      { label: "Pricing model", vvterm: "Free + Pro + Lifetime", competitor: "Varies" },
      { label: "Lifetime / one-time option", vvterm: "check", competitor: "Varies" },
      { label: "Open source", vvterm: "check", competitor: "check" },
    ] as { label: string; vvterm: Cell; competitor: Cell }[],
    standout: [
      {
        icon: "lucide:folder-open-dot",
        title: "A real SFTP file browser",
        body: "Browse remote folders, upload and download, rename, move, delete, create directories, and edit POSIX permissions — with preview for text, images, and video in the same app.",
      },
      {
        icon: "lucide:square-terminal",
        title: "GPU terminal engine",
        body: "VVTerm renders with libghostty on Metal for true color, ligatures, and accurate output across iPhone, iPad, and Mac.",
      },
      {
        icon: "lucide:waypoints",
        title: "Transports beyond Mosh",
        body: "Standard SSH and Mosh, plus Tailscale SSH and Cloudflare Tunnel SSH for reaching machines on a tailnet or behind a tunnel with no ports forwarded.",
      },
      {
        icon: "lucide:badge-dollar-sign",
        title: "Clear pricing with a lifetime option",
        body: "Free to start, Pro at $6.49/month or $24.99/year, or a one-time $49.99 lifetime license.",
      },
    ],
    faqItems: [
      {
        question: "Is VVTerm a good Blink Shell alternative?",
        answer:
          "Yes, especially if you want a built-in SFTP file browser with preview, iCloud-synced servers, and modern transports like Tailscale SSH and Cloudflare Tunnel SSH alongside Mosh. Both are native Apple terminals with strong Mosh support, so the decision often comes down to file browsing, sync, and pricing preferences.",
      },
      {
        question: "Do both apps support Mosh?",
        answer:
          "Yes. Mosh is a core strength of both VVTerm and Blink Shell. Mosh keeps sessions alive across network changes, sleep, and flaky connections with instant local echo. VVTerm adds Tailscale SSH and Cloudflare Tunnel SSH on top of standard SSH and Mosh.",
      },
      {
        question: "Does VVTerm support Windows or Linux?",
        answer:
          "The VVTerm client runs only on Apple devices — iPhone, iPad, and Mac — and Blink Shell runs on iPhone and iPad, so neither is the choice if you need a Windows or Linux <strong>client</strong>. VVTerm does connect <strong>to</strong> Linux, macOS, BSD, and Windows/PowerShell servers, with live stats and persistent sessions on each.",
      },
      {
        question: "What does VVTerm add over Blink Shell?",
        answer:
          "On top of shared Mosh support, VVTerm includes a full <strong>SFTP file browser</strong> with preview, <strong>managed tmux session persistence</strong>, <strong>live server monitoring</strong>, <strong>on-device voice-to-command</strong>, extra transports (Tailscale SSH and Cloudflare Tunnel SSH), and 440 built-in themes — with a one-time lifetime price. Blink Shell counters with a long-refined, keyboard-first, terminal-centric workflow.",
      },
      {
        question: "Which is cheaper, VVTerm or Blink Shell?",
        answer:
          "VVTerm is free for one workspace, one server, and one connection tab, with Pro at $6.49/month or $24.99/year and a one-time $49.99 lifetime license. Blink Shell's pricing model can vary over time — check their site for current details before deciding.",
      },
      {
        question: "Can I import my servers from Blink Shell?",
        answer:
          "VVTerm does not offer a direct Blink Shell import. You add servers by entering the host, port, username, and authentication method. Credentials are stored in Apple Keychain and server metadata syncs through iCloud.",
      },
      {
        question: "Are both apps open source?",
        answer:
          "Both projects publish source. VVTerm's source is available at github.com/vivy-company/vvterm, and Blink Shell is open source under the GPL-3.0 license.",
      },
    ],
    ctaTitle: "Bring files and transports along.",
    ctaSubtitle: "Download VVTerm free on iPhone, iPad, and Mac, and try the terminal, SFTP, and Mosh together.",
  },
  zh: {
    title: "VVTerm vs Blink Shell — Apple SSH 终端对比",
    description:
      "VVTerm 对比 Blink Shell：两款支持 Mosh 的 Apple 终端，在平台、传输方式、内置 SFTP 文件浏览器、iCloud 同步和价格上的对比。",
    bcHome: "首页",
    bcCompare: "对比",
    heroTitle: "两款 Apple 终端，<br />都为 Mosh 而生。",
    heroSubhead:
      "VVTerm 和 Blink Shell 都是支持 Mosh 的原生 Apple 终端。VVTerm 可在 iPhone、iPad 和 Mac 上运行，而 Blink Shell 专注于 iPhone 和 iPad。差异还体现在 SFTP 文件浏览器、提供的传输方式、iCloud 同步以及各自的定价上。以下是对二者的公正审视。",
    download: "下载 VVTerm",
    seePricing: "查看价格",
    heroNote: "iPhone、iPad 和 Mac · 专为 Apple 设计",
    heroAlt: "Apple 设备上的 VVTerm 终端与 SFTP 浏览器",
    tableEyebrow: "逐项对比",
    tableTitle: "VVTerm 与 Blink Shell，并排比较。",
    tableBody:
      "两者都是以 <strong>Mosh</strong> 为核心的<strong>原生 Apple 终端</strong>。VVTerm 增加了内置 SFTP 浏览器、更多传输方式以及终身买断选项。",
    colFeature: "功能",
    footnote:
      'Blink Shell 的相关信息基于公开可得的资料，可能会有变化；请查阅其官网了解最新详情。标记为"—"或"Varies"的单元格表示该功能因套餐而异，或我们无法将其断言为确定事实。',
    standoutEyebrow: "VVTerm 的独到之处",
    standoutTitle: "不只是终端。",
    whyLabel: "为什么选 VVTerm？",
    whyEyebrow: "为什么选 VVTerm",
    whyTitle: "Mosh，还有更多。",
    whyBody:
      "两款应用都把 Mosh 做得很好。VVTerm 在此基础上配以<strong>由 libghostty 驱动的 GPU 终端</strong>、内置带文本、图片和视频预览的 <strong>SFTP 文件浏览器</strong>、<strong>Tailscale SSH 和 Cloudflare Tunnel SSH</strong> 等更多传输方式、<strong>iCloud 元数据同步</strong>，以及一次性 <strong>$49.99 终身</strong>选项。",
    whyAlt: "VVTerm SFTP 文件浏览器与 shell 并排",
    seeEverything: "查看 VVTerm 的全部功能",
    fitEyebrow: "Blink Shell 何时更合适",
    fitTitle: "一款成熟、以终端为先的工具。",
    fitBody:
      "Blink Shell 多年来一直是 iOS 终端领域备受尊敬的名字，<strong>专注于 Mosh</strong>，并拥有许多高级用户钟爱的<strong>以键盘驱动、以终端为中心</strong>的工作流。如果你的首要需求是一款久经考验、偏重配置、命令行优先的 shell —— 以及一个长期打磨它的社区 —— 那么它是绝佳选择。VVTerm 追求另一种平衡：原生 GPU 终端搭配内置 SFTP 浏览器、iCloud 同步和更多传输方式，并提供终身价格。",
    rows: [
      { label: "平台", vvterm: "iPhone、iPad、Mac", competitor: "iPhone、iPad" },
      { label: "原生 Apple 应用", vvterm: "check", competitor: "check" },
      { label: "终端引擎", vvterm: "libghostty（GPU）", competitor: "—" },
      { label: "标准 SSH", vvterm: "check", competitor: "check" },
      { label: "Mosh", vvterm: "check", competitor: "check" },
      { label: "Tailscale SSH", vvterm: "check", competitor: "—" },
      { label: "Cloudflare Tunnel SSH", vvterm: "check", competitor: "—" },
      { label: "内置 SFTP 文件浏览器", vvterm: "check", competitor: "Varies" },
      { label: "文件预览（文本/图片/视频）", vvterm: "check", competitor: "—" },
      { label: "托管的 tmux 会话持久化", vvterm: "check", competitor: "—" },
      { label: "连接 Windows/PowerShell 服务器", vvterm: "check", competitor: "check" },
      { label: "实时服务器指标（CPU/内存/磁盘）", vvterm: "check", competitor: "—" },
      { label: "本地设备语音转命令", vvterm: "check", competitor: "—" },
      { label: "内置终端主题", vvterm: "440 款主题", competitor: "Varies" },
      { label: "iCloud 同步", vvterm: "check", competitor: "Varies" },
      { label: "凭据存于 Apple Keychain", vvterm: "check", competitor: "—" },
      { label: "定价模式", vvterm: "免费 + 专业版 + 终身版", competitor: "Varies" },
      { label: "终身/一次性买断选项", vvterm: "check", competitor: "Varies" },
      { label: "开源", vvterm: "check", competitor: "check" },
    ] as { label: string; vvterm: Cell; competitor: Cell }[],
    standout: [
      {
        icon: "lucide:folder-open-dot",
        title: "真正的 SFTP 文件浏览器",
        body: "浏览远程文件夹，上传和下载，重命名、移动、删除、创建目录，并编辑 POSIX 权限 —— 在同一应用内预览文本、图片和视频。",
      },
      {
        icon: "lucide:square-terminal",
        title: "GPU 终端引擎",
        body: "VVTerm 在 Metal 上以 libghostty 渲染，在 iPhone、iPad 和 Mac 上呈现真彩色、连字和精准输出。",
      },
      {
        icon: "lucide:waypoints",
        title: "Mosh 之外的传输方式",
        body: "标准 SSH 和 Mosh，外加 Tailscale SSH 和 Cloudflare Tunnel SSH，无需转发端口即可连接 tailnet 上或隧道后的机器。",
      },
      {
        icon: "lucide:badge-dollar-sign",
        title: "清晰定价，含终身选项",
        body: "免费开始，专业版每月 $6.49 或每年 $24.99，或一次性购买 $49.99 的终身授权。",
      },
    ],
    faqItems: [
      {
        question: "VVTerm 是 Blink Shell 的好替代品吗？",
        answer:
          "是的，尤其当你想要带预览的内置 SFTP 文件浏览器、iCloud 同步的服务器，以及 Tailscale SSH 和 Cloudflare Tunnel SSH 等现代传输方式与 Mosh 并存时。两者都是对 Mosh 支持良好的原生 Apple 终端，因此选择往往取决于文件浏览、同步和定价偏好。",
      },
      {
        question: "两款应用都支持 Mosh 吗？",
        answer:
          "是的。Mosh 是 VVTerm 和 Blink Shell 共同的核心优势。Mosh 在网络变化、睡眠和不稳定连接期间保持会话存活，并提供即时本地回显。VVTerm 在标准 SSH 和 Mosh 之上还增加了 Tailscale SSH 和 Cloudflare Tunnel SSH。",
      },
      {
        question: "VVTerm 支持 Windows 或 Linux 吗？",
        answer:
          "VVTerm 客户端仅在 Apple 设备上运行 —— iPhone、iPad 和 Mac —— 而 Blink Shell 运行于 iPhone 和 iPad，因此若你需要 Windows 或 Linux <strong>客户端</strong>，两者都不是选择。VVTerm 确实可以连接<strong>到</strong> Linux、macOS、BSD 和 Windows/PowerShell 服务器，并在每种服务器上提供实时统计和持久会话。",
      },
      {
        question: "VVTerm 相比 Blink Shell 增加了什么？",
        answer:
          "在共同的 Mosh 支持之上，VVTerm 包含带预览的完整 <strong>SFTP 文件浏览器</strong>、<strong>托管的 tmux 会话持久化</strong>、<strong>实时服务器监控</strong>、<strong>本地设备语音转命令</strong>、额外的传输方式（Tailscale SSH 和 Cloudflare Tunnel SSH），以及 440 款内置主题 —— 并提供一次性终身价格。Blink Shell 则以长期打磨、键盘优先、以终端为中心的工作流取胜。",
      },
      {
        question: "VVTerm 和 Blink Shell 哪个更便宜？",
        answer:
          "VVTerm 对一个工作区、一台服务器和一个连接标签免费，专业版每月 $6.49 或每年 $24.99，并提供一次性 $49.99 的终身授权。Blink Shell 的定价模式可能随时间变化 —— 决定前请查阅其官网了解最新详情。",
      },
      {
        question: "我可以从 Blink Shell 导入我的服务器吗？",
        answer:
          "VVTerm 不提供直接的 Blink Shell 导入。你需要输入主机、端口、用户名和身份验证方式来添加服务器。凭据保存在 Apple Keychain 中，服务器元数据通过 iCloud 同步。",
      },
      {
        question: "两款应用都是开源的吗？",
        answer:
          "两个项目都发布了源代码。VVTerm 的源代码可在 github.com/vivy-company/vvterm 获取，Blink Shell 则以 GPL-3.0 许可证开源。",
      },
    ],
    ctaTitle: "把文件和传输方式一并带上。",
    ctaSubtitle: "在 iPhone、iPad 和 Mac 上免费下载 VVTerm，把终端、SFTP 和 Mosh 一起体验。",
  },
}, lang);
---

<MarketingLayout
  title={C.title}
  description={C.description}
  canonicalPath="/compare/vvterm-vs-blink-shell"
  activeTop="resources"
>
  <Breadcrumbs
    items={[
      { name: C.bcHome, href: "/" },
      { name: C.bcCompare, href: "/compare" },
      { name: C.title, href: "/compare/vvterm-vs-blink-shell" },
    ]}
  />

  <!-- HERO -->
  <section class="px-6 pb-8 pt-10 text-center sm:pt-14">
    <div class="mx-auto max-w-4xl">
      <p class="eyebrow-accent">VVTerm vs {competitor}</p>
      <h1 class="mt-3 headline-hero" set:html={C.heroTitle} />
      <p class="mx-auto mt-6 max-w-2xl subhead">{C.heroSubhead}</p>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-x-7 gap-y-4">
        <DownloadButton label={C.download} track="compare_blink_appstore" />
        <a href={localizePath("/pricing", lang)} class="link-arrow">{C.seePricing} <span aria-hidden="true">›</span></a>
      </div>
      <p class="mt-5 text-[13px] text-faint">{C.heroNote}</p>
    </div>
    <div class="mx-auto mt-14 max-w-5xl">
      <MediaBlock pos="8% 45%" alt={C.heroAlt} />
    </div>
  </section>

  <!-- COMPARISON TABLE -->
  <section class="section">
    <div class="container-wide">
      <div class="text-center">
        <p class="eyebrow-accent">{C.tableEyebrow}</p>
        <h2 class="mt-3 headline">{C.tableTitle}</h2>
        <p class="mx-auto mt-6 max-w-2xl body-emph" set:html={C.tableBody} />
      </div>

      <div class="mt-12 overflow-x-auto">
        <table class="w-full min-w-[640px] border-collapse text-left">
          <thead>
            <tr class="border-b border-line">
              <th class="py-4 pr-4 text-sm font-medium text-muted">{C.colFeature}</th>
              <th class="px-4 py-4 text-base font-semibold text-ink">VVTerm</th>
              <th class="px-4 py-4 text-base font-semibold text-ink">{competitor}</th>
            </tr>
          </thead>
          <tbody>
            {C.rows.map((row) => (
              <tr class="border-b border-line">
                <th scope="row" class="py-4 pr-4 text-left text-[15px] font-normal text-ink/90">{row.label}</th>
                {[row.vvterm, row.competitor].map((cell) => (
                  <td class="px-4 py-4 text-[15px] text-muted">
                    {cell === "check" ? (
                      <Icon class="size-5 text-accent" name="lucide:check" />
                    ) : cell === "cross" ? (
                      <Icon class="size-5 text-faint" name="lucide:x" />
                    ) : cell === "dash" ? (
                      <span class="text-faint">—</span>
                    ) : (
                      <span>{cell}</span>
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="mt-6 max-w-2xl text-[13px] leading-relaxed text-faint">{C.footnote}</p>
    </div>
  </section>

  <!-- WHERE VVTERM STANDS OUT -->
  <section class="px-6 pb-12 sm:pb-16">
    <div class="container-wide">
      <div class="text-center">
        <p class="eyebrow-accent">{C.standoutEyebrow}</p>
        <h2 class="mt-3 headline">{C.standoutTitle}</h2>
      </div>
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {C.standout.map((item) => (
          <article class="card p-7">
            <Icon class="size-6 text-accent" name={item.icon} />
            <h3 class="mt-4 text-xl font-semibold tracking-[-0.02em] text-ink">{item.title}</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-muted">{item.body}</p>
          </article>
        ))}
      </div>
      <div class="mt-14 flex justify-center">
        <Expandable id="blink-why" label={C.whyLabel}>
          <div class="mx-auto max-w-3xl text-center">
            <p class="eyebrow-accent">{C.whyEyebrow}</p>
            <h2 class="mt-3 headline">{C.whyTitle}</h2>
            <p class="mx-auto mt-6 max-w-2xl body-emph" set:html={C.whyBody} />
          </div>
          <div class="mx-auto mt-14 max-w-5xl">
            <MediaBlock pos="92% 50%" ratio="aspect-[16/10]" alt={C.whyAlt} />
          </div>
          <div class="mt-12 text-center">
            <a href={localizePath("/features", lang)} class="link-arrow">{C.seeEverything} <span aria-hidden="true">›</span></a>
          </div>
        </Expandable>
      </div>
    </div>
  </section>

  <!-- WHERE COMPETITOR MIGHT FIT -->
  <section class="px-6 pb-20 sm:pb-28">
    <div class="container-apple">
      <div class="card p-8 sm:p-10">
        <p class="eyebrow-accent">{C.fitEyebrow}</p>
        <h2 class="mt-3 headline-sm">{C.fitTitle}</h2>
        <p class="mt-6 body-emph" set:html={C.fitBody} />
      </div>
    </div>
  </section>

  <FaqAccordion items={C.faqItems} />

  <CTABand
    title={C.ctaTitle}
    subtitle={C.ctaSubtitle}
    track="compare_blink_cta_appstore"
  />
</MarketingLayout>
