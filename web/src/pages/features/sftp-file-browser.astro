---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CTABand from "../../components/CTABand.astro";
import DownloadButton from "../../components/DownloadButton.astro";
import FaqAccordion from "../../components/FaqAccordion.astro";
import MediaBlock from "../../components/MediaBlock.astro";
import Carousel from "../../components/Carousel.astro";
import { Icon } from "astro-icon/components";
import { SITE, softwareAppSchema } from "../../lib/site";
import { localizePath, pickPage } from "../../i18n/utils";

const lang = (Astro.currentLocale ?? "en") as "en" | "zh";

const C = pickPage("features/sftp-file-browser", lang);

const appSchema = softwareAppSchema({ name: "VVTerm SFTP File Browser", operatingSystem: "iOS 16+, macOS 13+", path: localizePath("/features/sftp-file-browser", lang), description: C.description });
---

<MarketingLayout title={C.title} description={C.description} canonicalPath="/features/sftp-file-browser" activeTop="features" structuredData={[appSchema]}>
  <Breadcrumbs items={[{ name: C.bcHome, href: "/" }, { name: C.bcFeatures, href: "/features" }, { name: C.bcThis, href: "/features/sftp-file-browser" }]} />

  <!-- HERO -->
  <section class="px-6 pb-8 pt-10 text-center sm:pt-14">
    <div class="mx-auto max-w-4xl">
      <Icon class="mx-auto size-12 text-accent" name="lucide:folder-open-dot" />
      <p class="mt-5 eyebrow-accent">{C.heroEyebrow}</p>
      <h1 class="mt-3 headline-hero" set:html={C.heroTitle} />
      <p class="mx-auto mt-6 max-w-2xl subhead">{C.heroSubhead}</p>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-x-7 gap-y-4">
        <DownloadButton track="sftp_hero_appstore" />
        <a href={localizePath("/pricing", lang)} class="link-arrow">{C.seePricing} <span aria-hidden="true">›</span></a>
      </div>
      <p class="mt-5 text-[13px] text-faint">{C.heroNote}</p>
    </div>
    <div class="mx-auto mt-14 max-w-4xl">
      <MediaBlock pos="8% 50%" alt={C.heroAlt} />
    </div>
  </section>

  <!-- BIG STATEMENT -->
  <section class="section">
    <div class="container-apple text-center">
      <p class="eyebrow-accent">{C.statementEyebrow}</p>
      <h2 class="mt-3 headline">{C.statementTitle}</h2>
      <p class="mx-auto mt-6 max-w-2xl body-emph" set:html={C.statementBody} />
    </div>
  </section>

  <!-- CARDS CAROUSEL -->
  <section class="py-16 sm:py-24">
    <div class="container-wide">
      <h2 class="headline">{C.cardsTitle}</h2>
    </div>
    <Carousel label={C.carouselLabel} variant="row">
      {C.cards.map((card) => (
        <article class="w-[74vw] shrink-0 snap-start sm:w-[400px]">
          <div class="aspect-[4/3] overflow-hidden rounded-[28px] bg-[#1d1d1f]">
            <img src="/preview.png" alt="" class="size-full object-cover" style={`object-position:${card.pos}`} loading="lazy" />
          </div>
          <p class="mt-5 max-w-[42ch] text-base leading-relaxed text-muted">
            <strong class="font-semibold text-ink">{card.title}</strong> {card.body}
          </p>
        </article>
      ))}
    </Carousel>
  </section>

  <!-- CROSS-LINK -->
  <section class="section">
    <div class="container-wide grid items-center gap-12 lg:grid-cols-2">
      <MediaBlock class="order-2 lg:order-1" pos="92% 50%" alt={C.crossAlt} />
      <div class="order-1 max-w-xl lg:order-2">
        <p class="eyebrow-accent">{C.crossEyebrow}</p>
        <h2 class="mt-3 headline">{C.crossTitle}</h2>
        <p class="mt-6 body-emph" set:html={C.crossBody} />
        <div class="mt-8 flex flex-col gap-3">
          <a href={localizePath("/guides/sftp-file-transfer-on-ios", lang)} class="inline-flex link-arrow">{C.guideLink} <span aria-hidden="true">›</span></a>
          <a href={localizePath("/features/ssh-terminal", lang)} class="inline-flex link-arrow">{C.terminalLink} <span aria-hidden="true">›</span></a>
        </div>
      </div>
    </div>
  </section>

  <FaqAccordion items={C.faqItems} />

  <CTABand title={C.ctaTitle} subtitle={C.ctaSubtitle} track="sftp_cta_appstore" />
</MarketingLayout>
