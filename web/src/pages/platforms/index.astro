---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CTABand from "../../components/CTABand.astro";
import DownloadButton from "../../components/DownloadButton.astro";
import { Icon } from "astro-icon/components";
import { SITE } from "../../lib/site";
import { PLATFORMS } from "../../lib/nav";
import { localizePath, pickPage, useT, type Locale } from "../../i18n/utils";

const lang = (Astro.currentLocale ?? "en") as Locale;

const C = pickPage("platforms", lang);
const t = useT(lang);
const platformLabel = (name: string) => t("nav.platformLink").replace("{name}", name);

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: C.metaTitle,
  description: C.metaDescription,
  url: `${SITE.siteUrl}${localizePath("/platforms", lang)}`,
};
---

<MarketingLayout title={C.metaTitle} description={C.metaDescription} canonicalPath="/platforms" activeTop="platforms" structuredData={[webPageSchema]}>
  <Breadcrumbs items={[{ name: C.bcHome, href: "/" }, { name: C.bcPlatforms, href: "/platforms" }]} />

  <!-- HERO -->
  <section class="px-6 pb-8 pt-10 text-center sm:pt-14">
    <div class="mx-auto max-w-4xl">
      <p class="eyebrow-accent">{C.eyebrow}</p>
      <h1 class="mt-3 headline-hero" set:html={C.heroTitle} />
      <p class="mx-auto mt-6 max-w-2xl subhead">{C.heroSubhead}</p>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-x-7 gap-y-4">
        <DownloadButton track="platforms_hero_appstore" />
        <a href={localizePath("/features", lang)} class="link-arrow">{C.seeFeatures} <span aria-hidden="true">›</span></a>
      </div>
      <p class="mt-5 text-[13px] text-faint">{C.heroNote}</p>
    </div>
  </section>

  <!-- PLATFORM GRID -->
  <section class="section">
    <div class="container-wide">
      <div class="grid gap-4 md:grid-cols-3">
        {PLATFORMS.map((platform) => {
          const card = C.cards[platform.slug as keyof typeof C.cards];
          return (
            <a href={localizePath(`/${platform.slug}`, lang)} class="group card flex flex-col p-8 transition hover:border-white/25">
              <Icon class="size-8 text-accent" name={platform.icon} />
              <h2 class="mt-5 text-2xl font-semibold tracking-[-0.02em] text-ink">{platformLabel(platform.name)}</h2>
              <p class="mt-3 text-base font-medium text-ink/80">{card.tagline}</p>
              <p class="mt-3 flex-1 text-[15px] leading-relaxed text-muted">{card.summary}</p>
              <p class="mt-5 text-[13px] text-faint">{card.requirement}</p>
              <span class="mt-6 link-arrow">
                {C.explore} {platform.name}
                <Icon class="size-4 transition group-hover:translate-x-1" name="lucide:arrow-right" />
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <CTABand title={C.ctaTitle} subtitle={C.ctaSubtitle} track="platforms_cta_appstore" />
</MarketingLayout>
