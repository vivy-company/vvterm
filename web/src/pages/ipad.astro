---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CTABand from "../components/CTABand.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import Carousel from "../components/Carousel.astro";
import MediaBlock from "../components/MediaBlock.astro";
import Expandable from "../components/Expandable.astro";
import ConnectTabs from "../components/ConnectTabs.astro";
import { Icon } from "astro-icon/components";
import { SITE, softwareAppSchema } from "../lib/site";
import { localizePath , pick } from "../i18n/utils";

const lang = (Astro.currentLocale ?? "en") as "en" | "zh";

const C = pick({
  en: {
    metaTitle: "VVTerm for iPad — Turn iPad into an SSH Workstation",
    metaDescription: "A native SSH terminal and SFTP client for iPad. Hardware-keyboard shortcuts, Stage Manager multitasking, a custom terminal keyboard toolbar, tmux session persistence, Mosh roaming, live server monitoring, external display, and iCloud-synced servers.",
    bcHome: "Home",
    bcPlatforms: "Platforms",
    bcIpad: "iPad",
    heroEyebrow: "VVTerm for iPad",
    heroTitle: "Turn iPad into an<br />SSH workstation.",
    heroSubhead: "Hardware-keyboard shortcuts, Stage Manager multitasking, a terminal toolbar, and Mosh sessions that roam — with a built-in SFTP browser and iCloud-synced servers.",
    download: "Download for iPad",
    seePricing: "See pricing",
    heroNote: "Requires iPadOS 16 or later",
    heroAlt: "VVTerm SSH terminal on iPad",
    statementEyebrow: "More than a tablet",
    statementTitle: "A serious shell, on iPad.",
    statementBody: "VVTerm treats the <strong>hardware keyboard</strong> as a first-class input, fills in the keys iPadOS hides with a <strong>terminal toolbar</strong>, and keeps running across <strong>Stage Manager</strong> windows and external displays.",
    tourTitle: "Built for the way you work on iPad.",
    tourLabel: "iPad app tour",
    tourCards: [
      { title: "Hardware keyboard, first class.", body: "Magic Keyboard shortcuts, a full key map, and real arrow and modifier handling for shell work." },
      { title: "Stage Manager ready.", body: "Run the terminal beside docs and browsers with overlapping windows and multitasking." },
      { title: "External display.", body: "Connect a display for a larger workspace and keep your session right where you left it." },
    ],
    kbEyebrow: "Every key you need",
    kbTitle: "The keys iPadOS hides, one tap away.",
    kbBody: "A terminal keyboard toolbar puts <strong>Esc, Tab, and Ctrl</strong>, arrow keys, and <strong>function keys</strong> right above the keyboard — and you can customize it with your own <strong>command snippets and shortcuts</strong>. Plug in a Magic Keyboard and the physical keys map straight through to your shell.",
    kbLink: "Customize the toolbar",
    kbCaption: "Toolbar above the on-screen keyboard",
    connectEyebrow: "Connect your way",
    connectTitle: "Four ways to reach every machine.",
    connectBody: "Standard SSH when you want it, and <strong>Mosh</strong>, <strong>Tailscale SSH</strong>, or <strong>Cloudflare Tunnel SSH</strong> when you need them — no port forwarding to set up.",
    moshEyebrow: "Mosh roaming",
    moshTitle: "Carry your session everywhere.",
    moshBody: "Walk from desk Wi-Fi to cellular, sleep the iPad, change networks — with <strong>Mosh</strong>, your session stays put and reconnects on its own. Standard <strong>SSH is always there</strong> as a fallback.",
    moshAlt: "VVTerm Mosh roaming session on iPad",
    filesEyebrow: "Files, built in",
    filesTitle: "SFTP, right beside your shell.",
    filesBody: "Browse remote folders, <strong>upload and download</strong>, create directories, rename, move, and delete — then preview text, images, and video or <strong>edit POSIX permissions</strong>, all on iPad.",
    filesAlt: "VVTerm SFTP file browser on iPad",
    expandLabel: "Explore the SFTP browser",
    modalEyebrow: "SFTP file browser",
    modalTitle: "A file manager built for iPad.",
    modalBody: "Browse remote folders, <strong>upload and download</strong>, create directories, rename, move, and delete — then <strong>preview text, images, and video</strong>, edit supported text files, and adjust POSIX permissions without a second app.",
    sftpLink: "Read the full SFTP overview",
    highlights: [
      { title: "GPU terminal engine", body: "libghostty draws every frame on Metal for true color, ligatures, and an accurate session." },
      { title: "Terminal keyboard toolbar", body: "Esc, Tab, Ctrl, arrows, and function keys sit above the keyboard for keys iPadOS hides." },
      { title: "Mosh roaming", body: "Sessions survive Wi-Fi to cellular handoffs and sleep, with SSH as a fallback." },
      { title: "iCloud-synced servers", body: "Your server list follows you from Mac and iPhone. Credentials stay in Keychain." },
    ],
    guideLink: "Read the iOS setup guide",
    moreEyebrow: "Even more",
    moreTitle: "A workstation, not a toy.",
    moreCards: [
      { title: "tmux persistence", body: "Close the lid or switch apps — your session keeps running on the server and reattaches when you come back." },
      { title: "Themes & fonts", body: "440 built-in themes, Nerd Fonts, cursor styles, and a keyboard toolbar you build yourself — synced from your other devices." },
      { title: "Live monitoring", body: "CPU, memory, network, disk, and top processes in real time, right next to your terminal." },
    ],
    learnMore: "Learn more",
    windowsNote: "Managing Windows boxes too?",
    windowsLink: "SSH to Windows servers ›",
    faqItems: [
      { question: "What does VVTerm for iPad need to run?", answer: "iPadOS 16 or later. The terminal renders on Metal, so a modern iPad gives the smoothest results." },
      { question: "Do I need an Apple Pencil?", answer: "No. VVTerm is built around the keyboard and touch. A hardware keyboard such as the Magic Keyboard makes shell work fastest, and the on-screen terminal toolbar covers the keys iPadOS would otherwise hide." },
      { question: "How do I type Esc, Tab, Ctrl, and arrows?", answer: "The terminal keyboard toolbar sits above the on-screen keyboard with Esc, Tab, Ctrl, arrow keys, and function keys. With a hardware keyboard the physical keys map straight through." },
      { question: "Does it work with Stage Manager and external displays?", answer: "Yes. Run VVTerm in Stage Manager beside other apps, and connect an external display for a larger workspace. Mosh keeps the session alive as you move around." },
      { question: "Will my session survive switching from Wi-Fi to cellular?", answer: "With Mosh, yes. Mosh roams across network changes and sleep and reconnects on its own, falling back to standard SSH when you prefer it." },
      { question: "What if I close the lid mid-task?", answer: "VVTerm manages a <strong>tmux</strong> session on the server, so a running command keeps going even after the connection drops, and reattaches the next time you connect — it installs tmux for you if it's missing." },
      { question: "Can I customize the keyboard toolbar?", answer: "Yes. Choose which keys appear and add your own <strong>command snippets</strong> (insert text, optionally with Enter) and <strong>shortcuts</strong> (a key with Ctrl, Alt, Cmd, or Shift). Your layout syncs across devices through iCloud." },
      { question: "Can I monitor server load on iPad?", answer: "Yes. Live monitoring shows CPU, memory, network, disk, load average, and top processes in real time over your existing SSH session." },
      { question: "How much does VVTerm cost?", answer: "It is free for one workspace, one server, and one connection tab. Pro is $6.49/month or $24.99/year, and a lifetime purchase is $49.99." },
    ],
    ctaTitle: "Make iPad your terminal.",
    ctaSubtitle: "Download VVTerm free and connect to your first server in minutes.",
  },
  zh: {
    metaTitle: "VVTerm for iPad — 把 iPad 变成 SSH 工作站",
    metaDescription: "为 iPad 打造的原生 SSH 终端与 SFTP 客户端。硬件键盘快捷键、台前调度多任务、自定义终端键盘工具栏、tmux 会话持久化、Mosh 漫游、实时服务器监控、外接显示器，以及 iCloud 同步服务器。",
    bcHome: "首页",
    bcPlatforms: "平台",
    bcIpad: "iPad",
    heroEyebrow: "VVTerm for iPad",
    heroTitle: "把 iPad 变成一台<br />SSH 工作站。",
    heroSubhead: "硬件键盘快捷键、台前调度多任务、终端工具栏，以及可漫游的 Mosh 会话 —— 内置 SFTP 浏览器，服务器通过 iCloud 同步。",
    download: "下载 iPad 版",
    seePricing: "查看价格",
    heroNote: "需要 iPadOS 16 或更高版本",
    heroAlt: "iPad 上的 VVTerm SSH 终端",
    statementEyebrow: "不只是一块平板",
    statementTitle: "iPad 上的认真 shell。",
    statementBody: "VVTerm 将<strong>硬件键盘</strong>视为一等输入，用<strong>终端工具栏</strong>补全 iPadOS 隐藏的按键，并在<strong>台前调度</strong>窗口和外接显示器之间持续运行。",
    tourTitle: "为你在 iPad 上的工作方式打造。",
    tourLabel: "iPad 应用导览",
    tourCards: [
      { title: "硬件键盘，一等公民。", body: "妙控键盘快捷键、完整的按键映射，以及为 shell 操作而生的方向键和修饰键处理。" },
      { title: "支持台前调度。", body: "在重叠窗口和多任务下，让终端与文档、浏览器并排运行。" },
      { title: "外接显示器。", body: "接上显示器获得更大的工作空间，会话仍停留在你离开时的位置。" },
    ],
    kbEyebrow: "你需要的每一个按键",
    kbTitle: "iPadOS 隐藏的按键，一触即达。",
    kbBody: "终端键盘工具栏把 <strong>Esc、Tab 和 Ctrl</strong>、方向键以及<strong>功能键</strong>放在键盘正上方 —— 你还能用自己的<strong>命令片段和快捷键</strong>自定义它。接上妙控键盘，物理按键便直接映射到你的 shell。",
    kbLink: "自定义工具栏",
    kbCaption: "屏幕键盘上方的工具栏",
    connectEyebrow: "按你的方式连接",
    connectTitle: "四种方式连接每一台机器。",
    connectBody: "需要时使用标准 SSH，也可在需要时选择 <strong>Mosh</strong>、<strong>Tailscale SSH</strong> 或 <strong>Cloudflare Tunnel SSH</strong> —— 无需设置端口转发。",
    moshEyebrow: "Mosh 漫游",
    moshTitle: "随身携带你的会话。",
    moshBody: "从办公桌 Wi-Fi 走到蜂窝网络、让 iPad 睡眠、切换网络 —— 有了 <strong>Mosh</strong>，你的会话原地不动并自行重连。标准 <strong>SSH 始终可用</strong>作为后备。",
    moshAlt: "iPad 上的 VVTerm Mosh 漫游会话",
    filesEyebrow: "内置文件管理",
    filesTitle: "SFTP，就在你的 shell 旁边。",
    filesBody: "浏览远程文件夹，<strong>上传和下载</strong>，创建目录、重命名、移动和删除 —— 然后预览文本、图片和视频，或<strong>编辑 POSIX 权限</strong>，全部在 iPad 上完成。",
    filesAlt: "iPad 上的 VVTerm SFTP 文件浏览器",
    expandLabel: "探索 SFTP 浏览器",
    modalEyebrow: "SFTP 文件浏览器",
    modalTitle: "为 iPad 打造的文件管理器。",
    modalBody: "浏览远程文件夹，<strong>上传和下载</strong>，创建目录、重命名、移动和删除 —— 然后<strong>预览文本、图片和视频</strong>，编辑受支持的文本文件，并调整 POSIX 权限，无需另开应用。",
    sftpLink: "阅读完整的 SFTP 介绍",
    highlights: [
      { title: "GPU 终端引擎", body: "libghostty 在 Metal 上绘制每一帧，呈现真彩色、连字和精准的会话。" },
      { title: "终端键盘工具栏", body: "Esc、Tab、Ctrl、方向键和功能键置于键盘上方，补全 iPadOS 隐藏的按键。" },
      { title: "Mosh 漫游", body: "会话可在 Wi-Fi 与蜂窝切换以及睡眠中存续，并以 SSH 作为后备。" },
      { title: "iCloud 同步服务器", body: "你的服务器列表从 Mac 和 iPhone 跟随而来。凭据始终保存在 Keychain 中。" },
    ],
    guideLink: "阅读 iOS 设置指南",
    moreEyebrow: "更多",
    moreTitle: "是工作站，不是玩具。",
    moreCards: [
      { title: "tmux 持久化", body: "合上盖子或切换应用 —— 你的会话在服务器上继续运行，回来时自动接回。" },
      { title: "主题与字体", body: "440 款内置主题、Nerd Fonts、光标样式，以及你亲手打造的键盘工具栏 —— 从你的其他设备同步而来。" },
      { title: "实时监控", body: "在终端旁实时查看 CPU、内存、网络、磁盘和占用最高的进程。" },
    ],
    learnMore: "了解更多",
    windowsNote: "也在管理 Windows 主机？",
    windowsLink: "SSH 连接 Windows 服务器 ›",
    faqItems: [
      { question: "VVTerm for iPad 的运行要求是什么？", answer: "iPadOS 16 或更高版本。终端在 Metal 上渲染，因此较新的 iPad 体验最流畅。" },
      { question: "我需要 Apple Pencil 吗？", answer: "不需要。VVTerm 围绕键盘和触控而设计。妙控键盘等硬件键盘让 shell 操作最快，而屏幕上的终端工具栏覆盖了 iPadOS 否则会隐藏的按键。" },
      { question: "我如何输入 Esc、Tab、Ctrl 和方向键？", answer: "终端键盘工具栏位于屏幕键盘上方，提供 Esc、Tab、Ctrl、方向键和功能键。使用硬件键盘时，物理按键直接映射。" },
      { question: "它支持台前调度和外接显示器吗？", answer: "支持。可在台前调度中让 VVTerm 与其他应用并排运行，并接上外接显示器获得更大的工作空间。你四处移动时，Mosh 让会话保持存活。" },
      { question: "从 Wi-Fi 切换到蜂窝网络后我的会话还在吗？", answer: "用 Mosh 就在。Mosh 在网络变化和睡眠中漫游并自行重连，需要时也可回退到标准 SSH。" },
      { question: "如果我中途合上盖子怎么办？", answer: "VVTerm 在服务器上管理 <strong>tmux</strong> 会话，因此即使连接断开，运行中的命令也会继续，并在你下次连接时自动接回 —— 若缺少 tmux，会为你安装。" },
      { question: "我可以自定义键盘工具栏吗？", answer: "可以。选择显示哪些按键，并添加你自己的<strong>命令片段</strong>（插入文本，可选附带回车）和<strong>快捷键</strong>（搭配 Ctrl、Alt、Cmd 或 Shift 的按键）。你的布局通过 iCloud 在设备间同步。" },
      { question: "我可以在 iPad 上监控服务器负载吗？", answer: "可以。实时监控通过你现有的 SSH 会话实时显示 CPU、内存、网络、磁盘、平均负载和占用最高的进程。" },
      { question: "VVTerm 多少钱？", answer: "一个工作区、一台服务器和一个连接标签页免费。Pro 为每月 $6.49 或每年 $24.99，终身买断为 $49.99。" },
    ],
    ctaTitle: "让 iPad 成为你的终端。",
    ctaSubtitle: "免费下载 VVTerm，几分钟内连接你的第一台服务器。",
  },
}, lang);

const softwareSchema = softwareAppSchema({ name: "VVTerm for iPad", operatingSystem: "iPadOS 16+", path: localizePath("/ipad", lang), description: C.metaDescription });
---

<MarketingLayout title={C.metaTitle} description={C.metaDescription} canonicalPath="/ipad" activeTop="platforms" structuredData={[softwareSchema]}>
  <Breadcrumbs items={[{ name: C.bcHome, href: "/" }, { name: C.bcPlatforms, href: "/#platforms" }, { name: C.bcIpad, href: "/ipad" }]} />

  <!-- HERO -->
  <section class="px-6 pb-8 pt-10 text-center sm:pt-14">
    <div class="mx-auto max-w-4xl">
      <Icon class="mx-auto size-12 text-ink" name="lucide:tablet" />
      <p class="mt-5 eyebrow-accent">{C.heroEyebrow}</p>
      <h1 class="mt-3 headline-hero" set:html={C.heroTitle} />
      <p class="mx-auto mt-6 max-w-2xl subhead">{C.heroSubhead}</p>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-x-7 gap-y-4">
        <a class="btn-primary" href={SITE.appStoreUrl} target="_blank" rel="noopener noreferrer" data-track="ipad_appstore_hero" data-conversion-value="0">{C.download}</a>
        <a href={localizePath("/pricing", lang)} class="link-arrow">{C.seePricing} <span aria-hidden="true">›</span></a>
      </div>
      <p class="mt-5 text-[13px] text-faint">{C.heroNote}</p>
    </div>
    <div class="mx-auto mt-14 max-w-4xl">
      <MediaBlock pos="30% 35%" alt={C.heroAlt} />
    </div>
  </section>

  <!-- STATEMENT -->
  <section class="section">
    <div class="container-apple text-center">
      <p class="eyebrow-accent">{C.statementEyebrow}</p>
      <h2 class="mt-3 headline">{C.statementTitle}</h2>
      <p class="mx-auto mt-6 max-w-2xl body-emph" set:html={C.statementBody} />
    </div>
  </section>

  <!-- TOUR CAROUSEL -->
  <section class="py-16 sm:py-24">
    <div class="container-wide">
      <h2 class="headline">{C.tourTitle}</h2>
    </div>
    <Carousel label={C.tourLabel} variant="row">
      {C.tourCards.map((card, i) => (
        <article class="w-[74vw] shrink-0 snap-start sm:w-[400px]">
          <div class="aspect-[4/3] overflow-hidden rounded-[28px] bg-[#1d1d1f]">
            <img src="/preview.png" alt="" class="size-full object-cover" style={`object-position:${["30% 35%", "72% 60%", "45% 20%"][i]}`} loading="lazy" />
          </div>
          <p class="mt-5 max-w-[42ch] text-base leading-relaxed text-muted">
            <strong class="font-semibold text-ink">{card.title}</strong> {card.body}
          </p>
        </article>
      ))}
    </Carousel>
  </section>

  <!-- KEYBOARD TOOLBAR -->
  <section class="section">
    <div class="container-wide grid items-center gap-12 lg:grid-cols-2">
      <div class="max-w-xl">
        <p class="eyebrow-accent">{C.kbEyebrow}</p>
        <h2 class="mt-3 headline">{C.kbTitle}</h2>
        <p class="mt-6 body-emph" set:html={C.kbBody} />
        <a href={localizePath("/features/terminal-customization", lang)} class="mt-7 inline-flex link-arrow">{C.kbLink} <span aria-hidden="true">›</span></a>
      </div>
      <div class="rounded-[28px] border border-white/10 bg-surface p-6 sm:p-8">
        <div class="grid grid-cols-4 gap-2 sm:gap-3">
          {["esc", "tab", "ctrl", "/", "↑", "↓", "←", "→", "F1", "F2", "|", "~"].map((key) => (
            <div class="grid h-12 place-items-center rounded-xl border border-white/10 bg-[#0c0c0e] font-mono text-sm text-ink/90">{key}</div>
          ))}
        </div>
        <p class="mt-5 text-center text-[13px] text-faint">{C.kbCaption}</p>
      </div>
    </div>
  </section>

  <!-- CONNECT pill-tabs -->
  <section class="section">
    <div class="container-wide text-center">
      <p class="eyebrow-accent">{C.connectEyebrow}</p>
      <h2 class="mx-auto mt-3 max-w-[16ch] headline">{C.connectTitle}</h2>
      <p class="mx-auto mt-6 max-w-2xl body-emph" set:html={C.connectBody} />
    </div>
    <ConnectTabs platform="iPad" />
  </section>

  <!-- MOSH gradient (full-bleed) -->
  <section class="py-24 sm:py-32">
    <div class="relative">
      <div aria-hidden="true" class="absolute inset-x-0 top-0 h-72 bg-[radial-gradient(120%_100%_at_50%_0%,rgba(41,151,255,0.45),rgba(120,80,255,0.25)_40%,transparent_70%)]"></div>
      <div class="container-apple relative pt-44 text-center">
        <p class="eyebrow-accent">{C.moshEyebrow}</p>
        <h2 class="mx-auto mt-3 max-w-[16ch] headline">{C.moshTitle}</h2>
        <p class="mx-auto mt-6 max-w-2xl body-emph" set:html={C.moshBody} />
        <div class="mx-auto mt-12 max-w-2xl">
          <MediaBlock pos="60% 40%" alt={C.moshAlt} />
        </div>
      </div>
    </div>
  </section>

  <!-- FILES two-column -->
  <section class="section">
    <div class="container-wide grid items-center gap-12 lg:grid-cols-2">
      <MediaBlock class="order-2 lg:order-1" pos="8% 50%" alt={C.filesAlt} />
      <div class="order-1 max-w-xl lg:order-2">
        <p class="eyebrow-accent">{C.filesEyebrow}</p>
        <h2 class="mt-3 headline">{C.filesTitle}</h2>
        <p class="mt-6 body-emph" set:html={C.filesBody} />
      </div>
    </div>
    <div class="container-wide mt-14 flex justify-center">
      <Expandable id="ipad-files" label={C.expandLabel}>
        <div class="mx-auto max-w-3xl text-center">
          <p class="eyebrow-accent">{C.modalEyebrow}</p>
          <h2 class="mt-3 headline">{C.modalTitle}</h2>
          <p class="mx-auto mt-6 max-w-2xl body-emph" set:html={C.modalBody} />
        </div>
        <div class="mx-auto mt-14 max-w-5xl">
          <MediaBlock pos="8% 50%" ratio="aspect-[16/10]" alt={C.filesAlt} />
        </div>
        <div class="mt-12 text-center">
          <a href={localizePath("/features/sftp-file-browser", lang)} class="link-arrow">{C.sftpLink} <span aria-hidden="true">›</span></a>
        </div>
      </Expandable>
    </div>
  </section>

  <!-- HIGHLIGHTS -->
  <section class="px-6 pb-20 sm:pb-28">
    <div class="container-wide grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {C.highlights.map((item, i) => (
        <article class="card p-7">
          <Icon class="size-6 text-accent" name={["lucide:square-terminal", "lucide:keyboard", "lucide:radio", "lucide:cloudy"][i]} />
          <h3 class="mt-4 text-xl font-semibold tracking-[-0.02em] text-ink">{item.title}</h3>
          <p class="mt-2 text-[15px] leading-relaxed text-muted">{item.body}</p>
        </article>
      ))}
    </div>
    <div class="container-wide mt-8">
      <a href={localizePath("/guides/how-to-ssh-from-iphone", lang)} class="inline-flex link-arrow">{C.guideLink} <span aria-hidden="true">›</span></a>
    </div>
  </section>

  <!-- MORE POWER -->
  <section class="px-6 pb-20 sm:pb-28">
    <div class="container-wide text-center">
      <p class="eyebrow-accent">{C.moreEyebrow}</p>
      <h2 class="mx-auto mt-3 max-w-[20ch] headline">{C.moreTitle}</h2>
    </div>
    <div class="container-wide mt-12 grid gap-4 sm:grid-cols-3">
      <a href={localizePath("/features/tmux-session-persistence", lang)} class="group card flex flex-col p-7 transition hover:border-white/25">
