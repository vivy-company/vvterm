---
import DocsLayout from "../../layouts/DocsLayout.astro";
import { SITE } from "../../lib/site";
import { localizePath, pickPage } from "../../i18n/utils";

const lang = (Astro.currentLocale ?? "en") as "en" | "zh";

const slug = "adding-a-server";

const C = pickPage("docs/adding-a-server", lang);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  name: C.heading,
  description: C.schemaDescription,
  url: `${SITE.siteUrl}${localizePath(`/docs/${slug}`, lang)}`,
};
---

<DocsLayout
  kind="docs"
  activeSlug={slug}
  heading={C.heading}
  intro={C.intro}
  meta={C.meta}
  title={C.title}
  description={C.description}
  canonicalPath={`/docs/${slug}`}
  structuredData={[articleSchema]}
>
  <Fragment set:html={C.bodyHtml} />
</DocsLayout>
