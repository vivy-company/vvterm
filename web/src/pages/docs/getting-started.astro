---
import DocsLayout from "../../layouts/DocsLayout.astro";
import { SITE } from "../../lib/site";
import { localizePath , pick } from "../../i18n/utils";

const lang = (Astro.currentLocale ?? "en") as "en" | "zh";

const slug = "getting-started";

const C = pick({
  en: {
    heading: "Getting started",
    intro:
      "Install VVTerm on iPhone, iPad, or Mac, add your first server, and open a secure shell session — then learn what the free tier includes and when Pro is worth it.",
    meta: "Documentation",
    title: "Getting started with VVTerm — VVTerm",
    description:
      "Install VVTerm on iPhone, iPad, or Mac, check system requirements, add your first server, connect over SSH, and learn the free and Pro tier limits.",
    schemaDescription:
      "Install VVTerm, check system requirements, add your first server, connect over SSH, and understand the free and Pro tiers.",
    bodyHtml: `
  <p>
    VVTerm is a native SSH terminal and SFTP file client for iPhone, iPad, and Mac. It renders the
    terminal on the GPU with <strong>libghostty</strong> and connects over SSH with <strong>libssh2</strong>, so sessions are fast and accurate. Beyond standard SSH, it can reach
    machines over <strong>Mosh</strong>, <strong>Tailscale SSH</strong>, and <strong>Cloudflare Tunnel SSH</strong>. This page gets you from install to your first prompt.
  </p>

  <h2>System requirements</h2>
  <ul>
    <li><strong>iPhone and iPad</strong> — iOS or iPadOS 16 or later.</li>
    <li><strong>Mac</strong> — macOS 13 Ventura or later on an Apple Silicon Mac. Intel Macs are not supported.</li>
  </ul>
  <p>
    VVTerm is one app across all three platforms, and your server list follows you between them
    through iCloud.
  </p>

  <h2>Install VVTerm</h2>
  <ol>
    <li>Open the App Store on your device and install VVTerm.</li>
    <li>Launch the app and finish the short welcome flow.</li>
    <li>VVTerm opens to an empty server list, ready for your first connection.</li>
  </ol>

  <h2>Add your first server</h2>
  <p>You need three details from the server you want to reach: its host, your username, and how you authenticate.</p>
  <ol>
    <li>Start a new server and give it a recognizable <strong>name</strong>.</li>
    <li>Enter the <strong>host</strong> — a hostname like <code>example.com</code> or an IP like <code>192.168.1.20</code>.</li>
    <li>Set the <strong>port</strong>. SSH uses <code>22</code> by default; change it only if your server listens elsewhere.</li>
    <li>Enter the <strong>username</strong> you log in with, such as <code>root</code> or <code>ubuntu</code>.</li>
    <li>Choose an authentication method — password, an SSH key, or an SSH key with a passphrase.</li>
  </ol>
  <p>
    For a full walkthrough of every field and how servers fit into workspaces, see <a href="/docs/adding-a-server">Adding a server</a>.
  </p>

  <h2>Connect</h2>
  <ol>
    <li>Save the server and select it from your list.</li>
    <li>The first time you connect to a host, VVTerm shows its key fingerprint so you can verify the host before trusting it.</li>
    <li>Once accepted, the terminal opens at the shell prompt and you can start working.</li>
  </ol>
  <p>
    On iPhone and iPad, a keyboard toolbar above the software keyboard adds <code>Esc</code>, <code>Tab</code>, <code>Ctrl</code>, arrow keys, and function keys that terminals depend on. On
    Mac, full keyboard handling works as you would expect from a native app.
  </p>

  <h2>Free vs Pro</h2>
  <p>VVTerm is free to use, with limits that suit a single machine:</p>
  <ul>
    <li><strong>Free</strong> — one workspace, one server, and one connection tab.</li>
    <li><strong>Pro</strong> — unlimited workspaces, servers, and connection tabs.</li>
  </ul>
  <p>
    Pro is <strong>$6.49 per month</strong> or <strong>$24.99 per year</strong>, with a one-time <strong>lifetime</strong> purchase at <strong>$49.99</strong>. Purchases, billing, and refunds are
    handled by Apple through your App Store account. When you are ready to organize more machines, see <a href="/docs/workspaces-and-tabs">Workspaces, environments, and tabs</a>.
  </p>
`,
  },
  zh: {
    heading: "快速上手",
    intro:
      "在 iPhone、iPad 或 Mac 上安装 VVTerm，添加你的第一台服务器，开启一个安全的 shell 会话 —— 然后了解免费版包含什么，以及何时值得升级 Pro。",
    meta: "文档",
    title: "VVTerm 快速上手 — VVTerm",
    description:
      "在 iPhone、iPad 或 Mac 上安装 VVTerm，检查系统要求，添加第一台服务器，通过 SSH 连接，并了解免费版和 Pro 版的限制。",
    schemaDescription:
      "安装 VVTerm、检查系统要求、添加第一台服务器、通过 SSH 连接，并了解免费版和 Pro 版。",
    bodyHtml: `
  <p>
    VVTerm 是一款面向 iPhone、iPad 和 Mac 的原生 SSH 终端和 SFTP 文件客户端。它用 <strong>libghostty</strong> 在 GPU 上渲染终端，并用 <strong>libssh2</strong> 通过 SSH 连接，因此会话快速而精准。除了标准 SSH，它还能通过
    <strong>Mosh</strong>、<strong>Tailscale SSH</strong> 和 <strong>Cloudflare Tunnel SSH</strong> 连接机器。本页带你从安装走到第一个命令提示符。
  </p>

  <h2>系统要求</h2>
  <ul>
    <li><strong>iPhone 和 iPad</strong> —— iOS 或 iPadOS 16 或更高版本。</li>
    <li><strong>Mac</strong> —— 搭载 Apple Silicon、运行 macOS 13 Ventura 或更高版本。不支持 Intel Mac。</li>
  </ul>
  <p>
    VVTerm 在这三个平台上是同一个应用，你的服务器列表会通过 iCloud 在它们之间跟随你。
  </p>

  <h2>安装 VVTerm</h2>
  <ol>
    <li>在设备上打开 App Store 并安装 VVTerm。</li>
    <li>启动应用，完成简短的欢迎流程。</li>
    <li>VVTerm 打开后是一个空的服务器列表，等待你的第一次连接。</li>
  </ol>

  <h2>添加你的第一台服务器</h2>
  <p>你需要从想连接的服务器获取三项信息：它的主机、你的用户名，以及你如何认证。</p>
  <ol>
    <li>新建一台服务器，给它起一个易识别的<strong>名称</strong>。</li>
    <li>输入<strong>主机</strong> —— 像 <code>example.com</code> 这样的主机名，或像 <code>192.168.1.20</code> 这样的 IP。</li>
    <li>设置<strong>端口</strong>。SSH 默认使用 <code>22</code>；只有当你的服务器监听在别处时才需更改。</li>
    <li>输入你用来登录的<strong>用户名</strong>，例如 <code>root</code> 或 <code>ubuntu</code>。</li>
    <li>选择一种认证方式 —— 密码、SSH 密钥，或带口令的 SSH 密钥。</li>
  </ol>
  <p>
    关于每个字段的完整说明以及服务器如何归入工作区，参见<a href="/zh/docs/adding-a-server">添加服务器</a>。
  </p>

  <h2>连接</h2>
  <ol>
    <li>保存服务器并从列表中选中它。</li>
    <li>首次连接某台主机时，VVTerm 会显示其密钥指纹，让你在信任前先验证主机。</li>
    <li>接受后，终端会在 shell 命令提示符处打开，你就可以开始工作了。</li>
  </ol>
  <p>
    在 iPhone 和 iPad 上，软件键盘上方的键盘工具栏提供了终端所依赖的 <code>Esc</code>、<code>Tab</code>、<code>Ctrl</code>、方向键和功能键。在
    Mac 上，完整的键盘处理一如原生应用般工作。
  </p>

  <h2>免费版与 Pro</h2>
  <p>VVTerm 可免费使用，其限制适合单台机器：</p>
  <ul>
    <li><strong>免费版</strong> —— 一个工作区、一台服务器、一个连接标签页。</li>
    <li><strong>Pro</strong> —— 无限工作区、服务器和连接标签页。</li>
  </ul>
  <p>
    Pro 为<strong>每月 $6.49</strong> 或<strong>每年 $24.99</strong>，另有一次性<strong>终身</strong>买断 <strong>$49.99</strong>。购买、计费和退款均由 Apple 通过你的 App Store 账户处理。当你准备好整理更多机器时，参见<a href="/zh/docs/workspaces-and-tabs">工作区、环境与标签页</a>。
  </p>
`,
  },
}, lang);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  name: C.heading,
  description: C.schemaDescription,
  url: `${SITE.siteUrl}${localizePath(`/docs/${slug}`, lang)}`,
};
---

<DocsLayout
  kind="docs"
  activeSlug={slug}
  heading={C.heading}
  intro={C.intro}
  meta={C.meta}
  title={C.title}
  description={C.description}
  canonicalPath={`/docs/${slug}`}
  structuredData={[articleSchema]}
>
  <Fragment set:html={C.bodyHtml} />
</DocsLayout>
