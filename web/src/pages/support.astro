---
import LegalPage from "../components/LegalPage.astro";
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { pickPage } from "../i18n/utils";

const lang = (Astro.currentLocale ?? "en") as "en" | "zh";

const content = pickPage("support", lang);
---

<MarketingLayout
  title={content.title}
  description={content.description}
  canonicalPath="/support"
  ogType="article"
>
  <LegalPage title={content.heading} description={content.pageDescription}>
    <section>
      <h2>{content.s1h}</h2>
      <p>
        {content.s1pre}<a href="mailto:vvterm@vivy.company">vvterm@vivy.company</a>{content.s1post}
      </p>
    </section>

    <section>
      <h2>{content.s2h}</h2>
      <p>{content.s2intro}</p>
      <ul>
        {content.s2list.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section>
      <h2>{content.s3h}</h2>
      <p>{content.s3p}</p>
    </section>
  </LegalPage>
</MarketingLayout>
