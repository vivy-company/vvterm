---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CTABand from "../components/CTABand.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import Carousel from "../components/Carousel.astro";
import MediaBlock from "../components/MediaBlock.astro";
import Expandable from "../components/Expandable.astro";
import ConnectTabs from "../components/ConnectTabs.astro";
import { Icon } from "astro-icon/components";
import { SITE, softwareAppSchema } from "../lib/site";
import { localizePath , pick } from "../i18n/utils";

const lang = (Astro.currentLocale ?? "en") as "en" | "zh";

const C = pick({
  en: {
    metaTitle: "VVTerm for iPhone — SSH Terminal in Your Pocket",
    metaDescription: "A native SSH terminal and SFTP client for iPhone. Fix servers on the go with Mosh reconnect, tmux session persistence, a custom keyboard toolbar, on-device voice-to-command, live server monitoring, Face ID app lock, and a built-in SFTP browser.",
    bcHome: "Home",
    bcPlatforms: "Platforms",
    bcIphone: "iPhone",
    heroEyebrow: "VVTerm for iPhone",
    heroTitle: "Your servers,<br />in your pocket.",
    heroSubhead: "Fix things on the go with Mosh reconnect, a terminal toolbar, on-device voice-to-command, and Face ID lock — plus a built-in SFTP browser and iCloud-synced servers.",
    download: "Download for iPhone",
    seePricing: "See pricing",
    heroNote: "Requires iOS 16 or later",
    heroAlt: "VVTerm SSH terminal on iPhone",
    statementEyebrow: "Built for the moment it breaks",
    statementTitle: "A full terminal that fits in a pocket.",
    statementBody: "When something needs a quick fix, VVTerm gives you the <strong>keys you need on a toolbar</strong>, <strong>Mosh sessions that reconnect</strong> themselves, and <strong>voice-to-command</strong> for when typing on glass is slow.",
    tourTitle: "Remote work, from anywhere.",
    tourLabel: "iPhone app tour",
    tourCards: [
      { title: "Reconnect from anywhere.", body: "Mosh keeps your session alive across Wi-Fi, cellular, and a locked screen, then picks right back up." },
      { title: "Voice to command.", body: "Dictate commands hands-free with on-device transcription when typing on glass is slow." },
      { title: "Face ID app lock.", body: "Lock VVTerm behind Face ID so a glance is all it takes to keep your servers private." },
    ],
    kbEyebrow: "Every key you need",
    kbTitle: "The keys iOS hides, one tap away.",
    kbBody: "A terminal keyboard toolbar puts <strong>Esc, Tab, and Ctrl</strong>, arrow keys, and <strong>function keys</strong> right above the keyboard — so vim, tmux, and shell shortcuts work the way they should on a phone.",
    kbCaption: "Toolbar above the on-screen keyboard",
    connectEyebrow: "Connect your way",
    connectTitle: "Four ways to reach every machine.",
    connectBody: "Standard SSH when you want it, and <strong>Mosh</strong>, <strong>Tailscale SSH</strong>, or <strong>Cloudflare Tunnel SSH</strong> when you need them — no port forwarding to set up.",
    voiceEyebrow: "Voice to command",
    voiceTitle: "Talk to your terminal.",
    voiceBody: "Dictate commands when typing on glass is slow. VVTerm turns speech into shell input with <strong>on-device transcription</strong> — MLX Whisper or Parakeet models, with Apple Speech as a fallback. Nothing is sent off-device to transcribe.",
    voiceAlt: "VVTerm voice-to-command on iPhone",
    filesEyebrow: "Files, built in",
    filesTitle: "SFTP, right beside your shell.",
    filesBody: "Browse remote folders, <strong>upload and download</strong>, create directories, rename, move, and delete — then preview text, images, and video or <strong>edit POSIX permissions</strong>, all from your phone.",
    filesAlt: "VVTerm SFTP file browser on iPhone",
    expandLabel: "Explore the SFTP browser",
    modalEyebrow: "SFTP file browser",
    modalTitle: "Remote files, in your pocket.",
    modalBody: "Browse remote folders, <strong>upload and download</strong>, create directories, rename, move, and delete — then <strong>preview text, images, and video</strong>, edit supported text files, and adjust POSIX permissions without a second app.",
    sftpLink: "Read the full SFTP overview",
    highlights: [
      { title: "GPU terminal engine", body: "libghostty draws every frame on Metal for true color, ligatures, and an accurate session." },
      { title: "Terminal keyboard toolbar", body: "Esc, Tab, Ctrl, arrows, and function keys sit above the keyboard for keys iOS hides." },
      { title: "Mosh roaming", body: "Sessions survive Wi-Fi to cellular handoffs and a locked phone, with SSH as a fallback." },
      { title: "Face ID app lock", body: "Biometric lock keeps your server list and live sessions private on a shared or lost phone." },
    ],
    guideLink1: "How to SSH from iPhone",
    guideLink2: "Set up Mosh on iOS",
    moreEyebrow: "Even more",
    moreTitle: "More than a quick fix.",
    moreCards: [
      { title: "tmux persistence", body: "Lock your phone or lose signal — VVTerm manages tmux so your session keeps running and reattaches when you're back." },
      { title: "Live monitoring", body: "Check CPU, memory, network, disk, and top processes in real time before you reach for a laptop." },
      { title: "Themes & toolbar", body: "440 themes, Nerd Fonts, and a keyboard toolbar you build with your own command snippets and shortcuts." },
    ],
    learnMore: "Learn more",
    windowsNote: "Managing Windows boxes too?",
    windowsLink: "SSH to Windows servers ›",
    faqItems: [
      { question: "What does VVTerm for iPhone need to run?", answer: "iOS 16 or later. The terminal renders on Metal, so a modern iPhone gives the smoothest results." },
      { question: "Can I really fix a server from my phone?", answer: "Yes. VVTerm is a full SSH terminal with the keys you need on a toolbar, Mosh sessions that reconnect on their own, and an SFTP browser for quick file edits — enough to handle an incident on the go." },
      { question: "How does voice-to-command work?", answer: "Speak a command and VVTerm transcribes it on-device using MLX Whisper or Parakeet models, with Apple Speech as a fallback. Nothing about your commands is sent to a server for transcription." },
      { question: "Will my session survive switching networks or locking the phone?", answer: "With Mosh, yes. Mosh roams across Wi-Fi and cellular and survives a locked screen, reconnecting on its own. Standard SSH is always available when you prefer it." },
      { question: "Will a running command keep going if I get disconnected?", answer: "Yes. VVTerm manages a <strong>tmux</strong> session on the server, so a long-running command keeps running through a drop or a locked phone and reattaches when you reconnect. It installs tmux for you if it's missing." },
      { question: "Can I check server load from my phone?", answer: "Yes. Live monitoring shows CPU, memory, network, disk, load average, and top processes in real time over your SSH session — handy for triaging before you reach a laptop." },
      { question: "How do I keep my servers private on my phone?", answer: "Turn on Face ID app lock. VVTerm stays locked behind biometrics, and credentials live in Apple Keychain rather than in synced data." },
      { question: "How much does VVTerm cost?", answer: "It is free for one workspace, one server, and one connection tab. Pro is $6.49/month or $24.99/year, and a lifetime purchase is $49.99." },
    ],
    ctaTitle: "Carry your servers with you.",
    ctaSubtitle: "Download VVTerm free and connect to your first server in minutes.",
  },
  zh: {
    metaTitle: "VVTerm for iPhone — 装进口袋的 SSH 终端",
    metaDescription: "为 iPhone 打造的原生 SSH 终端与 SFTP 客户端。随时随地排障：Mosh 重连、tmux 会话持久化、自定义键盘工具栏、设备端语音转命令、实时服务器监控、面容 ID 应用锁，以及内置 SFTP 浏览器。",
    bcHome: "首页",
    bcPlatforms: "平台",
    bcIphone: "iPhone",
    heroEyebrow: "VVTerm for iPhone",
    heroTitle: "你的服务器，<br />装进口袋。",
    heroSubhead: "随时随地排障：Mosh 重连、终端工具栏、设备端语音转命令，以及面容 ID 锁定 —— 还有内置 SFTP 浏览器和 iCloud 同步服务器。",
    download: "下载 iPhone 版",
    seePricing: "查看价格",
    heroNote: "需要 iOS 16 或更高版本",
    heroAlt: "iPhone 上的 VVTerm SSH 终端",
    statementEyebrow: "为出问题的那一刻而生",
    statementTitle: "装进口袋的完整终端。",
    statementBody: "当某处需要快速修复时，VVTerm 为你提供<strong>工具栏上所需的按键</strong>、<strong>能自行重连的 Mosh 会话</strong>，以及在玻璃上打字太慢时可用的<strong>语音转命令</strong>。",
    tourTitle: "随时随地的远程工作。",
    tourLabel: "iPhone 应用导览",
    tourCards: [
      { title: "随处重连。", body: "Mosh 在 Wi-Fi、蜂窝网络和锁屏之间让会话保持存活，随后立即接回。" },
      { title: "语音转命令。", body: "在玻璃上打字太慢时，用设备端转写免手输入命令。" },
      { title: "面容 ID 应用锁。", body: "用面容 ID 锁住 VVTerm，一瞥即可保护你的服务器隐私。" },
    ],
    kbEyebrow: "你需要的每一个按键",
    kbTitle: "iOS 隐藏的按键，一触即达。",
    kbBody: "终端键盘工具栏把 <strong>Esc、Tab 和 Ctrl</strong>、方向键以及<strong>功能键</strong>放在键盘正上方 —— 让 vim、tmux 和 shell 快捷键在手机上也能如常工作。",
    kbCaption: "屏幕键盘上方的工具栏",
    connectEyebrow: "按你的方式连接",
    connectTitle: "四种方式连接每一台机器。",
    connectBody: "需要时使用标准 SSH，也可在需要时选择 <strong>Mosh</strong>、<strong>Tailscale SSH</strong> 或 <strong>Cloudflare Tunnel SSH</strong> —— 无需设置端口转发。",
    voiceEyebrow: "语音转命令",
    voiceTitle: "对你的终端说话。",
    voiceBody: "在玻璃上打字太慢时口述命令。VVTerm 用<strong>设备端转写</strong>把语音变成 shell 输入 —— 采用 MLX Whisper 或 Parakeet 模型，并以 Apple Speech 作为后备。转写过程不会发送到设备之外。",
    voiceAlt: "iPhone 上的 VVTerm 语音转命令",
    filesEyebrow: "内置文件管理",
    filesTitle: "SFTP，就在你的 shell 旁边。",
    filesBody: "浏览远程文件夹，<strong>上传和下载</strong>，创建目录、重命名、移动和删除 —— 然后预览文本、图片和视频，或<strong>编辑 POSIX 权限</strong>，全部在手机上完成。",
    filesAlt: "iPhone 上的 VVTerm SFTP 文件浏览器",
    expandLabel: "探索 SFTP 浏览器",
    modalEyebrow: "SFTP 文件浏览器",
    modalTitle: "远程文件，装进口袋。",
    modalBody: "浏览远程文件夹，<strong>上传和下载</strong>，创建目录、重命名、移动和删除 —— 然后<strong>预览文本、图片和视频</strong>，编辑受支持的文本文件，并调整 POSIX 权限，无需另开应用。",
    sftpLink: "阅读完整的 SFTP 介绍",
    highlights: [
      { title: "GPU 终端引擎", body: "libghostty 在 Metal 上绘制每一帧，呈现真彩色、连字和精准的会话。" },
      { title: "终端键盘工具栏", body: "Esc、Tab、Ctrl、方向键和功能键置于键盘上方，补全 iOS 隐藏的按键。" },
      { title: "Mosh 漫游", body: "会话可在 Wi-Fi 与蜂窝切换以及锁屏中存续，并以 SSH 作为后备。" },
      { title: "面容 ID 应用锁", body: "生物识别锁定让你的服务器列表和实时会话在共用或丢失的手机上保持私密。" },
    ],
    guideLink1: "如何从 iPhone 进行 SSH",
    guideLink2: "在 iOS 上设置 Mosh",
    moreEyebrow: "更多",
    moreTitle: "不止是快速修复。",
    moreCards: [
      { title: "tmux 持久化", body: "锁住手机或失去信号 —— VVTerm 管理 tmux，让你的会话继续运行，回来时自动接回。" },
      { title: "实时监控", body: "在拿起笔记本之前，实时查看 CPU、内存、网络、磁盘和占用最高的进程。" },
      { title: "主题与工具栏", body: "440 款主题、Nerd Fonts，以及你用自己的命令片段和快捷键打造的键盘工具栏。" },
    ],
    learnMore: "了解更多",
    windowsNote: "也在管理 Windows 主机？",
    windowsLink: "SSH 连接 Windows 服务器 ›",
    faqItems: [
      { question: "VVTerm for iPhone 的运行要求是什么？", answer: "iOS 16 或更高版本。终端在 Metal 上渲染，因此较新的 iPhone 体验最流畅。" },
      { question: "我真的能从手机上修复服务器吗？", answer: "可以。VVTerm 是一个完整的 SSH 终端，工具栏上有你需要的按键、能自行重连的 Mosh 会话，以及用于快速编辑文件的 SFTP 浏览器 —— 足以在路上处理一次故障。" },
      { question: "语音转命令如何工作？", answer: "说出一条命令，VVTerm 便在设备端用 MLX Whisper 或 Parakeet 模型进行转写，并以 Apple Speech 作为后备。你的命令内容不会被发送到服务器进行转写。" },
      { question: "切换网络或锁屏后我的会话还在吗？", answer: "用 Mosh 就在。Mosh 在 Wi-Fi 与蜂窝间漫游，并能在锁屏后存续、自行重连。你也可随时选择标准 SSH。" },
      { question: "断线后运行中的命令还会继续吗？", answer: "会。VVTerm 在服务器上管理 <strong>tmux</strong> 会话，因此长时间运行的命令在断线或锁屏期间继续，并在你重新连接时自动接回。若缺少 tmux，会为你安装。" },
      { question: "我可以从手机查看服务器负载吗？", answer: "可以。实时监控通过你的 SSH 会话实时显示 CPU、内存、网络、磁盘、平均负载和占用最高的进程 —— 在拿到笔记本之前很方便用来排查。" },
      { question: "我如何在手机上保护服务器隐私？", answer: "打开面容 ID 应用锁。VVTerm 会保持生物识别锁定，凭据保存在 Apple Keychain 中，而非同步的数据里。" },
      { question: "VVTerm 多少钱？", answer: "一个工作区、一台服务器和一个连接标签页免费。Pro 为每月 $6.49 或每年 $24.99，终身买断为 $49.99。" },
    ],
    ctaTitle: "把你的服务器随身带着。",
    ctaSubtitle: "免费下载 VVTerm，几分钟内连接你的第一台服务器。",
  },
}, lang);

const softwareSchema = softwareAppSchema({ name: "VVTerm for iPhone", operatingSystem: "iOS 16+", path: localizePath("/iphone", lang), description: C.metaDescription });
---

<MarketingLayout title={C.metaTitle} description={C.metaDescription} canonicalPath="/iphone" activeTop="platforms" structuredData={[softwareSchema]}>
  <Breadcrumbs items={[{ name: C.bcHome, href: "/" }, { name: C.bcPlatforms, href: "/#platforms" }, { name: C.bcIphone, href: "/iphone" }]} />

  <!-- HERO -->
  <section class="px-6 pb-8 pt-10 text-center sm:pt-14">
    <div class="mx-auto max-w-4xl">
      <Icon class="mx-auto size-12 text-ink" name="lucide:smartphone" />
      <p class="mt-5 eyebrow-accent">{C.heroEyebrow}</p>
      <h1 class="mt-3 headline-hero" set:html={C.heroTitle} />
      <p class="mx-auto mt-6 max-w-2xl subhead">{C.heroSubhead}</p>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-x-7 gap-y-4">
        <a class="btn-primary" href={SITE.appStoreUrl} target="_blank" rel="noopener noreferrer" data-track="iphone_appstore_hero" data-conversion-value="0">{C.download}</a>
        <a href={localizePath("/pricing", lang)} class="link-arrow">{C.seePricing} <span aria-hidden="true">›</span></a>
      </div>
      <p class="mt-5 text-[13px] text-faint">{C.heroNote}</p>
    </div>
    <div class="mx-auto mt-14 max-w-4xl">
      <MediaBlock pos="45% 20%" alt={C.heroAlt} />
    </div>
  </section>

  <!-- STATEMENT -->
  <section class="section">
    <div class="container-apple text-center">
      <p class="eyebrow-accent">{C.statementEyebrow}</p>
      <h2 class="mt-3 headline">{C.statementTitle}</h2>
      <p class="mx-auto mt-6 max-w-2xl body-emph" set:html={C.statementBody} />
    </div>
  </section>

  <!-- TOUR CAROUSEL -->
  <section class="py-16 sm:py-24">
    <div class="container-wide">
      <h2 class="headline">{C.tourTitle}</h2>
    </div>
    <Carousel label={C.tourLabel} variant="row">
      {C.tourCards.map((card, i) => (
        <article class="w-[74vw] shrink-0 snap-start sm:w-[400px]">
          <div class="aspect-[4/3] overflow-hidden rounded-[28px] bg-[#1d1d1f]">
            <img src="/preview.png" alt="" class="size-full object-cover" style={`object-position:${["30% 35%", "45% 20%", "72% 60%"][i]}`} loading="lazy" />
          </div>
          <p class="mt-5 max-w-[42ch] text-base leading-relaxed text-muted">
            <strong class="font-semibold text-ink">{card.title}</strong> {card.body}
          </p>
        </article>
      ))}
    </Carousel>
  </section>

  <!-- KEYBOARD TOOLBAR -->
  <section class="section">
    <div class="container-wide grid items-center gap-12 lg:grid-cols-2">
      <div class="max-w-xl">
        <p class="eyebrow-accent">{C.kbEyebrow}</p>
        <h2 class="mt-3 headline">{C.kbTitle}</h2>
        <p class="mt-6 body-emph" set:html={C.kbBody} />
      </div>
      <div class="rounded-[28px] border border-white/10 bg-surface p-6 sm:p-8">
        <div class="grid grid-cols-4 gap-2 sm:gap-3">
          {["esc", "tab", "ctrl", "/", "↑", "↓", "←", "→", "F1", "F2", "|", "~"].map((key) => (
            <div class="grid h-12 place-items-center rounded-xl border border-white/10 bg-[#0c0c0e] font-mono text-sm text-ink/90">{key}</div>
          ))}
        </div>
        <p class="mt-5 text-center text-[13px] text-faint">{C.kbCaption}</p>
      </div>
    </div>
  </section>

  <!-- CONNECT pill-tabs -->
  <section class="section">
    <div class="container-wide text-center">
      <p class="eyebrow-accent">{C.connectEyebrow}</p>
      <h2 class="mx-auto mt-3 max-w-[16ch] headline">{C.connectTitle}</h2>
      <p class="mx-auto mt-6 max-w-2xl body-emph" set:html={C.connectBody} />
    </div>
    <ConnectTabs platform="iPhone" />
  </section>

  <!-- VOICE gradient (full-bleed) -->
  <section class="py-24 sm:py-32">
    <div class="relative">
      <div aria-hidden="true" class="absolute inset-x-0 top-0 h-72 bg-[radial-gradient(120%_100%_at_50%_0%,rgba(41,151,255,0.45),rgba(120,80,255,0.25)_40%,transparent_70%)]"></div>
      <div class="container-apple relative pt-44 text-center">
        <p class="eyebrow-accent">{C.voiceEyebrow}</p>
        <h2 class="mx-auto mt-3 max-w-[14ch] headline">{C.voiceTitle}</h2>
        <p class="mx-auto mt-6 max-w-2xl body-emph" set:html={C.voiceBody} />
        <div class="mx-auto mt-12 max-w-2xl">
          <MediaBlock pos="45% 20%" alt={C.voiceAlt} />
        </div>
      </div>
    </div>
  </section>

  <!-- FILES two-column -->
  <section class="section">
    <div class="container-wide grid items-center gap-12 lg:grid-cols-2">
      <MediaBlock class="order-2 lg:order-1" pos="8% 50%" alt={C.filesAlt} />
      <div class="order-1 max-w-xl lg:order-2">
        <p class="eyebrow-accent">{C.filesEyebrow}</p>
        <h2 class="mt-3 headline">{C.filesTitle}</h2>
        <p class="mt-6 body-emph" set:html={C.filesBody} />
      </div>
    </div>
    <div class="container-wide mt-14 flex justify-center">
      <Expandable id="iphone-files" label={C.expandLabel}>
        <div class="mx-auto max-w-3xl text-center">
          <p class="eyebrow-accent">{C.modalEyebrow}</p>
          <h2 class="mt-3 headline">{C.modalTitle}</h2>
          <p class="mx-auto mt-6 max-w-2xl body-emph" set:html={C.modalBody} />
        </div>
        <div class="mx-auto mt-14 max-w-5xl">
          <MediaBlock pos="8% 50%" ratio="aspect-[16/10]" alt={C.filesAlt} />
        </div>
        <div class="mt-12 text-center">
          <a href={localizePath("/features/sftp-file-browser", lang)} class="link-arrow">{C.sftpLink} <span aria-hidden="true">›</span></a>
        </div>
      </Expandable>
    </div>
  </section>

  <!-- HIGHLIGHTS -->
  <section class="px-6 pb-20 sm:pb-28">
    <div class="container-wide grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {C.highlights.map((item, i) => (
        <article class="card p-7">
          <Icon class="size-6 text-accent" name={["lucide:square-terminal", "lucide:keyboard", "lucide:radio", "lucide:scan-face"][i]} />
          <h3 class="mt-4 text-xl font-semibold tracking-[-0.02em] text-ink">{item.title}</h3>
          <p class="mt-2 text-[15px] leading-relaxed text-muted">{item.body}</p>
        </article>
      ))}
    </div>
    <div class="container-wide mt-8 flex flex-wrap gap-x-8 gap-y-3">
      <a href={localizePath("/guides/how-to-ssh-from-iphone", lang)} class="inline-flex link-arrow">{C.guideLink1} <span aria-hidden="true">›</span></a>
      <a href={localizePath("/guides/set-up-mosh-on-ios", lang)} class="inline-flex link-arrow">{C.guideLink2} <span aria-hidden="true">›</span></a>
    </div>
  </section>

  <!-- MORE POWER -->
  <section class="px-6 pb-20 sm:pb-28">
    <div class="container-wide text-center">
      <p class="eyebrow-accent">{C.moreEyebrow}</p>
      <h2 class="mx-auto mt-3 max-w-[20ch] headline">{C.moreTitle}</h2>
    </div>
    <div class="container-wide mt-12 grid gap-4 sm:grid-cols-3">
      <a href={localizePath("/features/tmux-session-persistence", lang)} class="group card flex flex-col p-7 transition hover:border-white/25">
        <Icon class="size-7 text-accent" name="lucide:history" />
        <h3 class="mt-4 text-xl font-semibold tracking-[-0.02em] text-ink">{C.moreCards[0].title}</h3>
        <p class="mt-2 flex-1 text-[15px] leading-relaxed text-muted">{C.moreCards[0].body}</p>
        <span class="mt-5 link-arrow">{C.learnMore} <Icon class="size-4 transition group-hover:translate-x-1" name="lucide:arrow-right" /></span>
      </a>
