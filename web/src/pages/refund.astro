---
import LegalPage from "../components/LegalPage.astro";
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { pickPage } from "../i18n/utils";

const lang = (Astro.currentLocale ?? "en") as "en" | "zh";

const content = pickPage("refund", lang);
---

<MarketingLayout
  title={content.title}
  description={content.description}
  canonicalPath="/refund"
  ogType="article"
>
  <LegalPage title={content.heading} lastUpdated={content.lastUpdated}>
    <section>
      <h2>{content.s1h}</h2>
      <p>{content.s1p}</p>
    </section>

    <section>
      <h2>{content.s2h}</h2>
      <p>{content.s2intro}</p>
      <ol>
        <li>{content.s2reportPre}<a href="https://reportaproblem.apple.com">reportaproblem.apple.com</a>{content.s2reportPost}</li>
        {content.s2steps.map((item) => <li>{item}</li>)}
      </ol>
      <p>{content.s2outro}</p>
    </section>

    <section>
      <h2>{content.s3h}</h2>
      <p>{content.s3intro}</p>
      <ol>
        {content.s3steps.map((item) => <li>{item}</li>)}
      </ol>
      <p>{content.s3outro}</p>
      <ul>
        {content.s3list.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section>
      <h2>{content.s4h}</h2>
      <p>{content.s4p}</p>
    </section>

    <section>
      <h2>{content.s5h}</h2>
      <p>
        {content.s5pre}<a href="mailto:vvterm@vivy.company">vvterm@vivy.company</a>{content.s5post}
      </p>
    </section>
  </LegalPage>
</MarketingLayout>
