---
import "../styles/global.css";
import { SITE } from "../lib/site";
import { getLocale, localizePath, HTML_LANG, LOCALES, DEFAULT_LOCALE, LOCALE_META } from "../i18n/utils";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogType?: "website" | "article";
  robots?: string;
  structuredData?: Array<Record<string, unknown>>;
}

const {
  title = SITE.title,
  description = SITE.description,
  canonicalPath = "/",
  ogType = "website",
  robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",
  structuredData = [],
} = Astro.props;

const lang = getLocale(Astro.url);
const ogLocale = LOCALE_META[lang].ogLocale;
// canonicalPath is the locale-agnostic route (e.g. "/mac"); build per-locale URLs from it.
const canonical = new URL(localizePath(canonicalPath, lang), SITE.siteUrl).toString();
const defaultHref = new URL(localizePath(canonicalPath, DEFAULT_LOCALE), SITE.siteUrl).toString();
const alternates = LOCALES.map((l) => ({
  hreflang: LOCALE_META[l].hreflang,
  href: new URL(localizePath(canonicalPath, l), SITE.siteUrl).toString(),
}));
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#000000" />
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Vivy Technologies" />
    <meta name="robots" content={robots} />
    <meta name="apple-itunes-app" content={`app-id=${SITE.appStoreId}`} />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={defaultHref} />
    <link rel="preconnect" href="https://analytics.vivy.app" />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${SITE.siteUrl}/og.png`} />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:site" content="@vvterm_com" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={`${SITE.siteUrl}/og.png`} />
    <script defer src="https://analytics.vivy.app/script.js" data-website-id={SITE.umamiWebsiteId}></script>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gtagId}`}></script>
    <script is:inline define:vars={{ gtagId: SITE.gtagId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      window.gtag = gtag;
      gtag("js", new Date());
      gtag("config", gtagId);
    </script>
    {structuredData.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </head>
  <body class="min-h-screen overflow-x-clip bg-black text-ink antialiased">
    <slot />
  </body>
</html>
