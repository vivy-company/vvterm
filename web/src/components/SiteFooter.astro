---
import { Icon } from "astro-icon/components";
import { SITE } from "../lib/site";
import { PLATFORMS, FEATURES } from "../lib/nav";
import { getLocale, useT, localizePath, alternatePath, LANG_LABELS, LOCALES } from "../i18n/utils";

const lang = getLocale(Astro.url);
const t = useT(lang);
const lp = (path: string) => localizePath(path, lang);
const platformLabel = (name: string) => t("nav.platformLink").replace("{name}", name);

// Every locale (current one highlighted) for the language dropdown.
const localeOptions = LOCALES.map((l) => ({
  href: alternatePath(Astro.url, l),
  label: LANG_LABELS[l],
  active: l === lang,
}));

const currentYear = new Date().getFullYear();

const columns = [
  {
    title: t("nav.platforms"),
    links: PLATFORMS.map((p) => ({ href: lp(`/${p.slug}`), label: platformLabel(p.name) })),
  },
  {
    title: t("nav.product"),
    links: [
      { href: lp("/features"), label: t("nav.features") },
      { href: lp("/pricing"), label: t("nav.pricing") },
      { href: lp(`/features/${FEATURES[0].slug}`), label: t("nav.feature.ssh-terminal") },
      { href: lp("/features/sftp-file-browser"), label: t("nav.feature.sftp-file-browser") },
    ],
  },
  {
    title: t("nav.resources"),
    links: [
      { href: lp("/guides"), label: t("nav.guides") },
      { href: lp("/docs"), label: t("nav.documentation") },
      { href: lp("/compare"), label: t("nav.comparisons") },
      { href: SITE.discordUrl, label: "Discord", external: true, track: "discord_click" },
      { href: SITE.githubUrl, label: "GitHub", external: true, track: "github_click_footer" },
    ],
  },
  {
    title: t("nav.legal"),
    links: [
      { href: lp("/privacy"), label: t("nav.privacy") },
      { href: lp("/terms"), label: t("nav.terms") },
      { href: lp("/refund"), label: t("nav.refunds") },
      { href: lp("/support"), label: t("nav.support") },
    ],
  },
];
---

<footer class="border-t border-line bg-black text-[12px] leading-5 text-faint">
  <div class="container-wide py-10">
    <div class="border-b border-line pb-6">
      <p class="max-w-3xl">{t("nav.requirement")}</p>
    </div>

    <div class="grid gap-8 pt-8 sm:grid-cols-2 lg:grid-cols-4">
      {columns.map((column) => (
        <div>
          <p class="font-semibold text-ink">{column.title}</p>
          <nav class="mt-3 grid gap-2.5">
            {column.links.map((link) => (
              <a
                href={link.href}
                class="w-fit text-faint transition hover:text-ink"
                {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                {...(link.track ? { "data-track": link.track } : {})}
              >
                {link.label}
              </a>
            ))}
          </nav>
        </div>
      ))}
    </div>

    <div class="mt-10 flex flex-col gap-4 border-t border-line pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p>{t("nav.copyright").replace("{year}", String(currentYear))}</p>
      <div class="flex items-center gap-5">
        <a href={lp("/privacy")} class="transition hover:text-ink">{t("nav.privacyPolicy")}</a>
        <a href={lp("/terms")} class="transition hover:text-ink">{t("nav.termsOfUse")}</a>
        <details data-lang-picker class="group relative">
          <summary class="flex cursor-pointer list-none items-center gap-1.5 text-faint transition hover:text-ink [&::-webkit-details-marker]:hidden">
            <Icon name="lucide:globe" class="size-3.5" />
            <span>{LANG_LABELS[lang]}</span>
            <Icon name="lucide:chevron-down" class="size-3 transition group-open:rotate-180" />
          </summary>
          <div class="absolute bottom-full right-0 z-20 mb-2 grid max-h-72 w-44 gap-0.5 overflow-y-auto overscroll-contain rounded-xl border border-line bg-surface p-1.5 shadow-xl">
            {localeOptions.map((o) => (
              <a
                href={o.href}
                class:list={[
                  "block rounded-lg px-3 py-1.5 transition",
                  o.active ? "bg-surface-hover text-ink" : "text-faint hover:bg-surface-hover hover:text-ink",
                ]}
                {...(o.active ? { "aria-current": "true" } : {})}
              >
                {o.label}
              </a>
            ))}
          </div>
        </details>
      </div>
    </div>
  </div>
</footer>
