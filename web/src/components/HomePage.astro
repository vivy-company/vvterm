---
import { Icon } from "astro-icon/components";
import { SITE, translations } from "../lib/site";
import { localizePath } from "../i18n/utils";
import { PLATFORMS } from "../lib/nav";
import Carousel from "./Carousel.astro";
import GalleryCard from "./GalleryCard.astro";
import MediaBlock from "./MediaBlock.astro";
import PricingCards from "./PricingCards.astro";
import Expandable from "./Expandable.astro";

const lang = (Astro.currentLocale ?? "en") as "en" | "zh";
const t = translations[lang] as typeof translations.en;
const tour = t.home.tour as unknown as Record<string, string>;
const files = t.home.files as unknown as Record<string, string>;

const featureItems = [
  { key: "rendering", icon: "lucide:square-terminal" },
  { key: "connect", icon: "lucide:plug-zap" },
  { key: "files", icon: "lucide:folder-open-dot" },
  { key: "preview", icon: "lucide:file-search-2" },
  { key: "pickup", icon: "lucide:smartphone" },
  { key: "organize", icon: "lucide:folders" }
] as const;

const suiteIcons = [
  "lucide:square-terminal", "lucide:radio", "lucide:waypoints", "lucide:cloud",
  "lucide:folder-open-dot", "lucide:cloudy", "lucide:key-round", "lucide:mic"
];

// NOTE: images are temporary crops of the hero composite (preview.png). Swap for real
// per-feature screenshots later — just replace `img` per card.
const tourCards = [
  { img: "/preview.png", pos: "100% 50%", caption: "top" },
  { img: "/preview.png", pos: "8% 45%", caption: "bottom" },
  { img: "/preview.png", pos: "52% 50%", caption: "top" },
  { img: "/preview.png", pos: "30% 35%", caption: "bottom" },
  { img: "/preview.png", pos: "72% 60%", caption: "top" },
  { img: "/preview.png", pos: "45% 20%", caption: "bottom" },
] as const;

const connectionTabs = [
  { key: "ssh", label: "SSH", pos: "100% 50%" },
  { key: "mosh", label: "Mosh", pos: "60% 40%" },
  { key: "tailscale", label: "Tailscale SSH", pos: "20% 60%" },
  { key: "cloudflare", label: "Cloudflare Tunnel", pos: "80% 30%" }
];

const fileCardIcons = [
  "lucide:folder-open-dot",
  "lucide:arrow-down-up",
  "lucide:file-search-2",
  "lucide:pencil",
  "lucide:shield",
  "lucide:cloudy",
];

const faqs = ["q1", "q2", "q3", "q4", "q5", "q6", "q7", "q8", "q9", "q10"] as const;

const highlightAnswer = (text: string) =>
  text
    .replace(/VVTerm/g, '<span class="font-medium text-ink">VVTerm</span>')
    .replace(/libghostty/g, '<span class="font-medium text-ink">libghostty</span>')
    .replace(/Ghostty/g, '<span class="font-medium text-ink">Ghostty</span>')
    .replace(/iCloud/g, '<span class="font-medium text-ink">iCloud</span>')
    .replace(/Apple Keychain/g, '<span class="font-medium text-ink">Apple Keychain</span>')
    .replace(/Keychain/g, '<span class="font-medium text-ink">Keychain</span>');
---

<main>
  <!-- HERO -->
  <section class="px-6 pt-20 sm:pt-32">
    <div class="mx-auto max-w-5xl">
      <img src="/preview.png" alt="VVTerm SSH terminal on iPhone, iPad, and Mac" width="1600" height="1100" class="w-full" loading="eager" fetchpriority="high" />
    </div>
    <div class="mx-auto mt-6 max-w-4xl text-center">
      <img src="/logo.png" alt="VVTerm app icon" width="64" height="64" class="mx-auto size-16 object-contain" />
      <p class="mt-5 text-[21px] font-semibold tracking-tight text-ink">VVTerm</p>
      <h1 class="mx-auto mt-4 max-w-[15ch] headline-hero">{t.hero.h1}</h1>
      <p class="mx-auto mt-6 max-w-xl text-lg leading-snug text-muted sm:text-[1.3125rem]">{t.hero.subtitle}</p>
    </div>
  </section>

  <!-- PROMO CARD -->
  <section class="section">
    <div class="container-wide">
      <div class="overflow-hidden rounded-[28px] bg-gradient-to-br from-[#1f1f22] to-[#0e0e10] p-8 sm:p-12">
        <div class="grid items-center gap-10 lg:grid-cols-2">
          <div>
            <h2 class="text-3xl font-semibold tracking-[-0.02em] text-ink sm:text-4xl">{t.home.promo.title}</h2>
            <p class="mt-4 max-w-md text-base leading-relaxed text-muted">{t.home.promo.desc}</p>
            <div class="mt-7 flex flex-wrap items-center gap-x-7 gap-y-4">
              <a class="btn-primary" href={SITE.appStoreUrl} target="_blank" rel="noopener noreferrer" data-track="appstore_click" data-conversion-value="0">
                <span>{t.hero.primaryCta}</span>
              </a>
              <a class="link-arrow" href={SITE.githubUrl} target="_blank" rel="noopener noreferrer" data-track="github_click_hero">
                <span>{t.hero.secondaryCta}</span>
                <span aria-hidden="true">›</span>
              </a>
            </div>
          </div>
          <div class="grid grid-cols-4 gap-3 sm:gap-4">
            {suiteIcons.map((icon) => (
              <div class="grid aspect-square place-items-center rounded-2xl border border-white/10 bg-white/5">
                <Icon class="size-7 text-accent" name={icon} />
              </div>
            ))}
          </div>
        </div>
      </div>
      <p class="mt-6 text-center text-sm text-faint" set:html={t.hero.meta.replace('href="/pricing"', `href="${localizePath("/pricing", lang)}"`)}></p>
    </div>
  </section>

  <!-- GET TO KNOW (center-mode gallery, Apple Logic style) -->
  <section class="py-16 sm:py-24">
    <div class="container-wide">
      <h2 class="headline">{t.home.tour.title}</h2>
    </div>
    <Carousel label="Get to know VVTerm">
      {tourCards.map((card, i) => (
        <GalleryCard img={card.img} pos={card.pos} title={tour[`c${i}`]} caption={card.caption as "top" | "bottom"} />
      ))}
    </Carousel>
  </section>

  <!-- CONNECT (pill-tab terminal demo) -->
  <section class="bg-[#09090b] section">
    <div class="container-wide text-center">
      <p class="eyebrow-accent">{t.home.connect.eyebrow}</p>
      <h2 class="mx-auto mt-3 max-w-[16ch] headline">{t.home.connect.title}</h2>
      <p class="mx-auto mt-6 max-w-2xl body-emph" set:html={highlightAnswer(t.home.connect.body)}></p>
    </div>

    <div class="container-wide mt-16" data-tabs>
      <div class="relative grid">
        {connectionTabs.map((tab, i) => (
          <div
            data-tab-panel={tab.key}
            class:list={[
              "col-start-1 row-start-1 transition-opacity duration-500 ease-out",
              i === 0 ? "opacity-100 z-10" : "opacity-0 pointer-events-none",
            ]}
          >
            <MediaBlock pos={tab.pos} ratio="aspect-[16/10]" alt={`VVTerm over ${tab.label}`} />
          </div>
        ))}
      </div>

      <div class="relative mx-auto mt-8 flex w-fit max-w-full flex-wrap justify-center gap-1 rounded-full border border-line bg-surface p-1">
        <span data-tab-indicator class="pointer-events-none absolute left-0 top-0 rounded-full bg-white opacity-0 transition-all duration-300 ease-out"></span>
        {connectionTabs.map((tab) => (
          <button type="button" data-tab-btn={tab.key} class="relative z-10 rounded-full px-4 py-2 text-sm font-medium text-ink/70 transition-colors">{tab.label}</button>
        ))}
      </div>
      <p class="mt-6 text-center text-sm text-faint"><span>{t.home.connect.caption}</span> <a href={localizePath("/features", lang)} class="text-accent hover:underline">{t.home.connect.captionLink}</a></p>
    </div>
  </section>

  <!-- TMUX PERSISTENCE (two column) -->
  <section class="section">
    <div class="container-wide grid items-center gap-12 lg:grid-cols-2">
      <div class="max-w-xl">
        <p class="eyebrow-accent">{t.home.tmux.eyebrow}</p>
        <h2 class="mt-3 headline">{t.home.tmux.title}</h2>
        <p class="mt-6 body-emph" set:html={highlightAnswer(t.home.tmux.body)}></p>
        <a href={localizePath("/features/tmux-session-persistence", lang)} class="mt-8 inline-flex link-arrow"><span>{t.home.tmux.link}</span> <span aria-hidden="true">›</span></a>
      </div>
      <MediaBlock pos="30% 35%" alt="VVTerm tmux session persistence" />
    </div>
  </section>

  <!-- CUSTOMIZATION + MONITORING (two-up) -->
  <section class="px-6 pb-24 sm:pb-32">
    <div class="container-wide grid gap-4 lg:grid-cols-2">
      <a href={localizePath("/features/terminal-customization", lang)} class="group card flex flex-col p-8 transition hover:border-white/25 sm:p-10">
        <Icon class="size-8 text-accent" name="lucide:palette" />
        <h3 class="mt-5 text-2xl font-semibold tracking-[-0.02em] text-ink">{t.home.custom.title}</h3>
        <p class="mt-3 flex-1 text-base leading-relaxed text-muted">{t.home.custom.body}</p>
        <span class="mt-6 link-arrow"><span>{t.home.custom.link}</span> <Icon class="size-4 transition group-hover:translate-x-1" name="lucide:arrow-right" /></span>
      </a>
      <a href={localizePath("/features/server-monitoring", lang)} class="group card flex flex-col p-8 transition hover:border-white/25 sm:p-10">
        <Icon class="size-8 text-accent" name="lucide:activity" />
        <h3 class="mt-5 text-2xl font-semibold tracking-[-0.02em] text-ink">{t.home.monitor.title}</h3>
        <p class="mt-3 flex-1 text-base leading-relaxed text-muted">{t.home.monitor.body}</p>
        <span class="mt-6 link-arrow"><span>{t.home.monitor.link}</span> <Icon class="size-4 transition group-hover:translate-x-1" name="lucide:arrow-right" /></span>
      </a>
    </div>
    <p class="container-wide mt-6 text-center text-sm text-faint"><span>{t.home.windows.caption}</span> <a href={localizePath("/features/windows-ssh", lang)} class="text-accent hover:underline">{t.home.windows.link}</a></p>
  </section>

  <!-- FILES (two column) -->
  <section class="section">
    <div class="container-wide grid items-center gap-12 lg:grid-cols-2">
      <MediaBlock class="order-2 lg:order-1" pos="8% 50%" alt="VVTerm SFTP file browser" />
      <div class="order-1 max-w-xl lg:order-2">
        <p class="eyebrow-accent">{t.home.files.eyebrow}</p>
        <h2 class="mt-3 headline">{t.home.files.title}</h2>
        <p class="mt-6 body-emph" set:html={highlightAnswer(t.home.files.body)}></p>
      </div>
    </div>
    <div class="container-wide mt-14 flex justify-center">
      <Expandable id="sftp" label={t.home.files.expand}>
        <div class="mx-auto max-w-3xl text-center">
          <p class="eyebrow-accent">{t.home.files.modalEyebrow}</p>
          <h2 class="mt-3 headline">{t.home.files.modalTitle}</h2>
          <p class="mx-auto mt-6 max-w-2xl body-emph" set:html={highlightAnswer(t.home.files.modalBody)}></p>
        </div>
        <div class="mx-auto mt-14 max-w-5xl">
          <MediaBlock pos="8% 50%" ratio="aspect-[16/10]" alt="VVTerm SFTP file browser" />
        </div>

        <div class="mx-auto mt-16 grid max-w-5xl gap-4 sm:grid-cols-3">
          {fileCardIcons.map((icon, i) => (
            <article class="card p-7 text-left">
              <Icon class="size-6 text-accent" name={icon} />
              <h3 class="mt-4 text-xl font-semibold tracking-[-0.02em] text-ink">{files[`card${i}title`]}</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-muted">{files[`card${i}body`]}</p>
            </article>
          ))}
        </div>

        <div class="mx-auto mt-16 max-w-4xl text-center">
          <h3 class="text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl">{t.home.files.outroTitle}</h3>
          <p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-muted">{t.home.files.outroBody}</p>
        </div>
        <div class="mx-auto mt-12 max-w-5xl">
          <MediaBlock pos="92% 50%" ratio="aspect-[16/9]" alt="VVTerm file transfer" />
        </div>

        <div class="mt-12 text-center">
          <a href={localizePath("/features/sftp-file-browser", lang)} class="link-arrow"><span>{t.home.files.overviewLink}</span> <span aria-hidden="true">›</span></a>
        </div>
      </Expandable>
    </div>
  </section>

  <!-- VOICE (full-bleed gradient) -->
  <section class="py-24 sm:py-32">
    <div class="relative">
      <div aria-hidden="true" class="absolute inset-x-0 top-0 h-72 bg-[radial-gradient(120%_100%_at_50%_0%,rgba(41,151,255,0.45),rgba(120,80,255,0.25)_40%,transparent_70%)]"></div>
      <div class="container-apple relative pt-44 text-center">
        <p class="eyebrow-accent">{t.home.voice.eyebrow}</p>
        <h2 class="mx-auto mt-3 max-w-[14ch] headline">{t.home.voice.title}</h2>
        <p class="mx-auto mt-6 max-w-2xl body-emph" set:html={highlightAnswer(t.home.voice.body)}></p>
        <div class="mx-auto mt-16 max-w-2xl">
          <MediaBlock pos="45% 20%" alt="VVTerm voice-to-command on iPhone" />
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURES carousel -->
  <section class="py-16 sm:py-24">
    <div class="container-wide">
      <p class="eyebrow-accent">{t.home.work.eyebrow}</p>
      <h2 class="mt-3 headline">{t.features.title}</h2>
    </div>
    <Carousel label="Features" variant="row">
      {featureItems.map((feature, i) => (
        <article class="w-[74vw] shrink-0 snap-start sm:w-[400px]">
          <div class="aspect-[4/3] overflow-hidden rounded-[28px] bg-[#1d1d1f]">
            <img src="/preview.png" alt="" class="size-full object-cover" style={`object-position:${["100% 40%", "0% 60%", "50% 50%", "80% 30%", "20% 70%", "60% 50%"][i]}`} loading="lazy" />
          </div>
          <p class="mt-5 max-w-[42ch] text-base leading-relaxed text-muted">
            <strong class="font-semibold text-ink">{t.features[feature.key].title}</strong>{" "}
            <span>{t.features[feature.key].desc}</span>
          </p>
        </article>
      ))}
    </Carousel>
    <div class="container-wide">
      <a href={localizePath("/features", lang)} class="mt-10 inline-flex link-arrow"><span>{t.home.work.all}</span> <span aria-hidden="true">›</span></a>
    </div>
  </section>

  <!-- PLATFORMS -->
  <section id="platforms" class="section">
    <div class="container-wide text-center">
      <p class="eyebrow-accent">Mac · iPad · iPhone</p>
      <h2 class="mx-auto mt-3 max-w-[18ch] headline">{t.platforms.title}</h2>
      <p class="mx-auto mt-6 max-w-2xl body-emph">{t.platforms.subtitle}</p>
    </div>
    <div class="container-wide mt-16 grid gap-4 md:grid-cols-3">
      {PLATFORMS.map((platform) => (
        <a href={localizePath(`/${platform.slug}`, lang)} class="group card flex flex-col p-8 transition hover:border-white/25">
          <Icon class="size-8 text-ink" name={platform.icon} />
          <h3 class="mt-5 text-2xl font-semibold tracking-[-0.02em] text-ink">VVTerm for {platform.name}</h3>
          <p class="mt-3 flex-1 text-base leading-relaxed text-muted">
            {t.platforms[platform.slug as "mac" | "ipad" | "iphone"].tagline}
          </p>
          <span class="mt-6 link-arrow">
            <span>{t.platforms.cta}</span>
            <Icon class="size-4 transition group-hover:translate-x-1" name="lucide:arrow-right" />
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- PRICING -->
  <section id="pricing" class="section">
    <div class="container-wide text-center">
      <h2 class="mx-auto max-w-[20ch] headline">{t.pricing.title}</h2>
      <p class="mx-auto mt-6 max-w-2xl body-emph">{t.pricing.subtitle}</p>
    </div>
    <PricingCards class="mt-16" />
  </section>

  <!-- FAQ -->
  <section id="faq" class="section">
    <div class="mx-auto max-w-[820px]">
      <h2 class="text-4xl font-semibold tracking-[-0.02em] text-ink sm:text-5xl">{t.faq.title}</h2>
      <div class="mt-10 border-t border-line">
        {faqs.map((key) => (
          <details class="group border-b border-line">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-left text-lg font-medium text-ink [&::-webkit-details-marker]:hidden">
              <span>{t.faq[key].question}</span>
              <Icon class="size-5 shrink-0 text-faint transition group-open:rotate-180" name="lucide:chevron-down" />
            </summary>
            <p class="pb-6 pr-10 text-base leading-relaxed text-muted" set:html={highlightAnswer(t.faq[key].answer)} />
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CLOSING -->
  <section class="px-6 py-24 text-center sm:py-32">
    <div class="mx-auto max-w-3xl">
      <img src="/logo.png" alt="" width="72" height="72" class="mx-auto size-18 object-contain" />
      <h2 class="mt-7 headline">{t.closing.title}</h2>
      <p class="mx-auto mt-5 max-w-xl subhead">{t.closing.subtitle}</p>
      <a class="btn-primary mt-9" href={SITE.appStoreUrl} target="_blank" rel="noopener noreferrer" data-track="closing_appstore_click" data-conversion-value="0">
        <span>{t.closing.cta}</span>
      </a>
    </div>
  </section>
</main>
